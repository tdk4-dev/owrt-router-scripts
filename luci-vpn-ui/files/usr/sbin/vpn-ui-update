#!/bin/ash
set -u

REPO="${VPN_UI_REPO:-tdk4-dev/owrt-router-scripts}"
RELEASE_BASE="${VPN_UI_RELEASE_BASE:-https://github.com/$REPO/releases/latest/download}"
VERSION_FILE="${VPN_UI_VERSION_FILE:-/usr/share/vpn-ui/version}"
MANIFEST_NAME="router-release-manifest.json"
PACKAGES_NAME="router-ui-packages.txt"
REMOTE_VERSION_NAME="vpn-ui-version.txt"
REMOTE_CHANGELOG_NAME="vpn-ui-changelog.txt"
REMOTE_RELEASE_DATE_NAME="vpn-ui-release-date.txt"
CONFIG_FILE="${VPN_UI_UPDATE_CONFIG:-/etc/vpn-ui-update.conf}"
CACHE_DIR="${VPN_UI_UPDATE_CACHE:-/etc/vpn-ui-update-cache}"
STATE_DIR="${VPN_UI_UPDATE_STATE:-/tmp/vpn-ui-update}"
LOCK_DIR="${VPN_UI_UPDATE_LOCK:-/tmp/vpn-ui-update.lock}"
LOG_FILE="${VPN_UI_UPDATE_LOG:-/tmp/vpn-ui-update.log}"
CRON_FILE="${VPN_UI_UPDATE_CRON:-/etc/crontabs/root}"
RESTART_CRON="${VPN_UI_UPDATE_RESTART_CRON:-1}"
CRON_MARKER="/usr/sbin/vpn-ui-update auto"
BACKUP_DIR="${VPN_UI_UPDATE_BACKUPS:-/root/router-ui-backups}"

json_escape() {
  printf '%s' "$1" |
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' |
    awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }'
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}

one_line() {
  printf '%s' "$1" | tr '\r\n' '  ' | sed 's/[[:space:]][[:space:]]*/ /g' | cut -c 1-500
}

die_json() {
  printf '{"ok":false,"error":'
  json_string "$(one_line "$*")"
  printf '}\n'
  exit 0
}

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

current_version() {
  cat "$VERSION_FILE" 2>/dev/null || printf 'development'
}

version_is_newer() {
  awk -v remote="$1" -v current="$2" 'BEGIN {
    remote_lower = tolower(remote)
    current_lower = tolower(current)
    remote_rc_pos = index(remote_lower, "rc")
    current_rc_pos = index(current_lower, "rc")
    remote_is_rc = remote_rc_pos > 0
    current_is_rc = current_rc_pos > 0
    remote_rc = remote_is_rc ? substr(remote_lower, remote_rc_pos + 2) + 0 : 0
    current_rc = current_is_rc ? substr(current_lower, current_rc_pos + 2) + 0 : 0
    remote_base = remote_is_rc ? substr(remote_lower, 1, remote_rc_pos - 1) : remote_lower
    current_base = current_is_rc ? substr(current_lower, 1, current_rc_pos - 1) : current_lower
    rn = split(remote_base, r, ".")
    cn = split(current_base, c, ".")
    n = rn > cn ? rn : cn
    for (i = 1; i <= n; i++) {
      rv = (r[i] ~ /^[0-9]+$/) ? r[i] + 0 : 0
      cv = (c[i] ~ /^[0-9]+$/) ? c[i] + 0 : 0
      if (rv > cv) exit 0
      if (rv < cv) exit 1
    }
    if (remote_is_rc && current_is_rc && remote_rc > current_rc) exit 0
    if (!remote_is_rc && current_is_rc) exit 0
    exit 1
  }'
}

read_file() {
  [ -f "$1" ] && cat "$1" || true
}

write_atomic() {
  local dst="$1"
  local tmp="$dst.$$"
  mkdir -p "$(dirname "$dst")"
  cat > "$tmp"
  mv "$tmp" "$dst"
}

ensure_config() {
  if [ ! -f "$CONFIG_FILE" ]; then
    {
      printf "AUTO_UPDATE='0'\n"
      printf "AUTO_SCHEDULE='Sunday 04:17'\n"
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
  fi
}

load_config() {
  AUTO_UPDATE="0"
  AUTO_SCHEDULE="Sunday 04:17"
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
}

configure_cron() {
  local tmp="$CRON_FILE.vpn-ui-update.$$"
  ensure_config
  load_config
  mkdir -p "$(dirname "$CRON_FILE")"
  touch "$CRON_FILE"
  grep -vF "$CRON_MARKER" "$CRON_FILE" > "$tmp" 2>/dev/null || true
  if [ "$AUTO_UPDATE" = "1" ]; then
    printf '%s\n' '17 4 * * 0 /usr/sbin/vpn-ui-update auto >/tmp/vpn-ui-auto-update.log 2>&1' >> "$tmp"
  fi
  mv "$tmp" "$CRON_FILE"
  chmod 600 "$CRON_FILE"
  if [ "$RESTART_CRON" = "1" ]; then
    /etc/init.d/cron enable >/dev/null 2>&1 || true
    /etc/init.d/cron restart >/dev/null 2>&1 || true
  fi
}

set_auto_update() {
  local enabled="$1"
  case "$enabled" in
    0|1) ;;
    *) die_json "auto-update setting must be 0 or 1" ;;
  esac
  {
    printf 'AUTO_UPDATE=%s\n' "$(shell_quote "$enabled")"
    printf "AUTO_SCHEDULE='Sunday 04:17'\n"
  } > "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  configure_cron
  status_json
}

set_state() {
  local status="$1"
  local stage="$2"
  local message="$3"
  local target="${4:-}"
  local backup="${5:-}"
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$status" | write_atomic "$STATE_DIR/status"
  printf '%s\n' "$stage" | write_atomic "$STATE_DIR/stage"
  printf '%s\n' "$message" | write_atomic "$STATE_DIR/message"
  printf '%s\n' "$target" | write_atomic "$STATE_DIR/target"
  printf '%s\n' "$backup" | write_atomic "$STATE_DIR/backup"
  date -u '+%Y-%m-%dT%H:%M:%SZ' | write_atomic "$STATE_DIR/updated_at"
}

clear_state() {
  rm -rf "$STATE_DIR"
  set_state "idle" "idle" "" "" ""
}

acquire_lock() {
  local owner=""
  if [ -d "$LOCK_DIR" ]; then
    owner="$(read_file "$LOCK_DIR/pid" | sed -n '1p')"
    if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$LOCK_DIR"
    fi
  fi
  mkdir "$LOCK_DIR" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
}

release_lock() {
  rm -rf "$LOCK_DIR"
}

lock_is_active() {
  local owner=""
  [ -d "$LOCK_DIR" ] || return 1
  owner="$(read_file "$LOCK_DIR/pid" | sed -n '1p')"
  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
    return 0
  fi
  rm -rf "$LOCK_DIR"
  return 1
}

download_file() {
  local url="$1"
  local dst="$2"
  local attempt=1

  while [ "$attempt" -le 3 ]; do
    if command -v curl >/dev/null 2>&1; then
      curl -4 -fsSL --proto '=https' --connect-timeout 10 --max-time 90 \
        "$url" -o "$dst" && return 0
    elif command -v wget >/dev/null 2>&1; then
      wget -4 -T 90 -qO "$dst" "$url" && return 0
    elif command -v uclient-fetch >/dev/null 2>&1; then
      uclient-fetch -4 -T 90 -q -O "$dst" "$url" && return 0
    else
      return 1
    fi
    rm -f "$dst"
    sleep $((attempt * 2))
    attempt=$((attempt + 1))
  done
  return 1
}

cache_release() {
  local version_file="$1"
  local changelog_file="$2"
  local date_file="$3"
  local compatible="$4"
  local version
  version="$(sed -n '1p' "$version_file" | tr -d '\r\n')"
  [ -n "$version" ] || return 1
  mkdir -p "$CACHE_DIR"
  cp "$version_file" "$CACHE_DIR/version.new"
  cp "$changelog_file" "$CACHE_DIR/changelog.new"
  cp "$date_file" "$CACHE_DIR/released_at.new"
  printf '%s\n' "$compatible" > "$CACHE_DIR/compatible.new"
  date -u '+%Y-%m-%dT%H:%M:%SZ' > "$CACHE_DIR/checked_at.new"
  mv "$CACHE_DIR/version.new" "$CACHE_DIR/version"
  mv "$CACHE_DIR/changelog.new" "$CACHE_DIR/changelog"
  mv "$CACHE_DIR/released_at.new" "$CACHE_DIR/released_at"
  mv "$CACHE_DIR/compatible.new" "$CACHE_DIR/compatible"
  mv "$CACHE_DIR/checked_at.new" "$CACHE_DIR/checked_at"
  chmod 600 "$CACHE_DIR"/* 2>/dev/null || true
}

check_transaction() {
  local tmpdir="/tmp/vpn-ui-update-check.$$"
  local strict="${1:-0}"
  local compatible=1
  mkdir -p "$tmpdir"
  download_file "$RELEASE_BASE/$REMOTE_VERSION_NAME" "$tmpdir/version" || {
    rm -rf "$tmpdir"
    return 1
  }
  download_file "$RELEASE_BASE/$REMOTE_CHANGELOG_NAME" "$tmpdir/changelog" || {
    rm -rf "$tmpdir"
    return 1
  }
  download_file "$RELEASE_BASE/$REMOTE_RELEASE_DATE_NAME" "$tmpdir/released_at" || {
    rm -rf "$tmpdir"
    return 1
  }
  download_file "$RELEASE_BASE/$MANIFEST_NAME" "$tmpdir/manifest" || compatible=0
  if [ "$compatible" = "1" ]; then
    download_file "$RELEASE_BASE/$PACKAGES_NAME" "$tmpdir/packages" || compatible=0
  fi
  cache_release "$tmpdir/version" "$tmpdir/changelog" "$tmpdir/released_at" "$compatible" || {
    rm -rf "$tmpdir"
    return 1
  }
  rm -rf "$tmpdir"
  [ "$strict" != "1" ] || [ "$compatible" = "1" ]
}

check_worker() {
  local target compatible current
  acquire_lock || {
    set_state "failed" "check" "Another update task is already running." "" ""
    return 1
  }
  set_state "running" "check" "Checking the release server…" "" ""
  if check_transaction >>"$LOG_FILE" 2>&1; then
    target="$(read_file "$CACHE_DIR/version" | sed -n '1p' | tr -d '\r\n')"
    compatible="$(read_file "$CACHE_DIR/compatible" | sed -n '1p')"
    current="$(current_version)"
    if [ "$compatible" = "1" ]; then
      set_state "success" "check" "Release information is current." "$target" ""
    elif version_is_newer "$current" "$target"; then
      set_state "success" "check" "Release server is reachable. Installed software is newer than the published legacy-format release; no package-first update is available." "$target" ""
    else
      set_state "success" "check" "Release server is reachable, but the published release uses the legacy bundle format and cannot be installed by the package-first updater." "$target" ""
    fi
    release_lock
    return 0
  fi
  set_state "failed" "check" "Could not contact or validate the release server." "" ""
  release_lock
  return 1
}

start_worker() {
  local worker="$1"
  if lock_is_active; then
    die_json "another update task is already running"
  fi
  set_state "starting" "$worker" "Starting…" "" ""
  "$0" "$worker-worker" >>"$LOG_FILE" 2>&1 </dev/null &
  printf '{"ok":true,"started":true,"job":'
  json_string "$worker"
  printf '}\n'
}

create_full_backup() {
  local target="$1"
  local ts backup checksum temporary bytes size_kb free_kb
  command -v sysupgrade >/dev/null 2>&1 || return 1
  mkdir -p "$BACKUP_DIR"
  chmod 700 "$BACKUP_DIR"
  ts="$(date +%Y%m%d-%H%M%S)"
  backup="$BACKUP_DIR/openwrt-before-router-ui-${target}-${ts}.tar.gz"
  temporary="/tmp/openwrt-before-router-ui-${target}-${ts}.tar.gz"
  rm -f "$temporary"
  sysupgrade -b "$temporary" >>"$LOG_FILE" 2>&1 || {
    rm -f "$temporary"
    return 1
  }
  [ -s "$temporary" ] || {
    rm -f "$temporary"
    return 1
  }
  tar -tzf "$temporary" >/dev/null 2>&1 || {
    rm -f "$temporary"
    return 1
  }
  bytes="$(wc -c < "$temporary" | tr -d ' ')"
  size_kb=$(((bytes + 1023) / 1024))
  free_kb="$(df -Pk "$BACKUP_DIR" 2>/dev/null | awk 'NR == 2 { print $4 }')"
  [ -n "$free_kb" ] && [ "$free_kb" -ge $((size_kb + 2048)) ] || {
    rm -f "$temporary"
    return 1
  }
  cp "$temporary" "$backup" || {
    rm -f "$temporary" "$backup"
    return 1
  }
  rm -f "$temporary"
  tar -tzf "$backup" >/dev/null 2>&1 || {
    rm -f "$backup"
    return 1
  }
  checksum="$(sha256sum "$backup" | awk '{ print $1 }')"
  printf '%s  %s\n' "$checksum" "$(basename "$backup")" > "$backup.sha256"
  chmod 600 "$backup" "$backup.sha256"
  printf '%s' "$backup"
}

validate_install() {
  local target="$1"
  [ "$(current_version)" = "$target" ] || return 1
  /usr/sbin/vpn-ui check 2>/dev/null | grep -q '"ok":true' || return 1
  /usr/sbin/vpn-ui vpn-summary 2>/dev/null | grep -q '"ok":true' || return 1
  [ -f /www/luci-static/resources/view/network/vpn.js ] ||
    [ -f /www/luci-static/resources/view/network/vpn-0-7-0.js ] || return 1
  [ -f /www/luci-static/resources/view/network/tailscale.js ] ||
    [ -f /www/luci-static/resources/view/network/tailscale-0-7-5.js ] || return 1
  [ -f /www/luci-static/resources/view/network/adguard.js ] || return 1
  [ -f /www/luci-static/resources/tools/router_footer.js ] || return 1
  [ -f /www/luci-static/resources/view/system/update.js ] ||
    [ -f /www/luci-static/resources/view/system/update-0-7-3.js ] || return 1
  [ -f /www/luci-static/resources/view/system/reset.js ] ||
    [ -f /www/luci-static/resources/view/system/reset-0-8-0.js ] || return 1
  [ -x /usr/sbin/install-router-ui-release ] || return 1
  [ -f /www/luci-static/resources/view/status/include/35_vpn.js ] || return 1
  if find /www/luci-static/resources/view/status/include -maxdepth 1 -type f -name '_35_vpn*.js' |
    grep -q .; then
    return 1
  fi
  if find /www/luci-static/resources/view/status/include -maxdepth 1 -type f -name '35_vpn-*.js' |
    grep -q .; then
    return 1
  fi
}

apply_transaction() {
  local target="$1"
  local backup

  set_state "running" "backup" "Creating and validating a full OpenWrt backup…" "$target" ""
  backup="$(create_full_backup "$target")" || {
    return 10
  }
  set_state "running" "download" "Downloading and verifying package release metadata…" "$target" "$backup"
  check_transaction 1 >>"$LOG_FILE" 2>&1 || return 11

  [ -x /usr/sbin/install-router-ui-release ] || return 16

  set_state "running" "install" "Installing Premier Router packages through opkg…" "$target" "$backup"
  ROUTER_UI_VERSION="$target" ROUTER_UI_REPO="$REPO" \
    ROUTER_UI_SKIP_BACKUP=1 ROUTER_UI_EXISTING_BACKUP="$backup" \
    sh /usr/sbin/install-router-ui-release >>"$LOG_FILE" 2>&1 || return 18

  set_state "running" "validate" "Validating services, configuration, and LuCI files…" "$target" "$backup"
  validate_install "$target" || return 19
  printf '%s' "$backup"
}

apply_worker() {
  local target compatible backup rc
  target="$(read_file "$CACHE_DIR/version" | sed -n '1p' | tr -d '\r\n')"
  [ -n "$target" ] || {
    set_state "failed" "apply" "Check for updates before installing." "" ""
    return 1
  }
  compatible="$(read_file "$CACHE_DIR/compatible" | sed -n '1p')"
  [ "$compatible" = "1" ] || {
    set_state "failed" "apply" "The published release does not contain package-first update metadata and cannot be installed by this updater." "$target" ""
    return 1
  }
  version_is_newer "$target" "$(current_version)" || {
    set_state "failed" "apply" "No newer stable release is available." "$target" ""
    return 1
  }
  acquire_lock || {
    set_state "failed" "apply" "Another update task is already running." "$target" ""
    return 1
  }
  backup=""
  if backup="$(apply_transaction "$target")"; then
    set_state "success" "complete" "Router software was updated and validated." "$target" "$backup"
    release_lock
    return 0
  else
    rc="$?"
  fi
  backup="$(read_file "$STATE_DIR/backup" | sed -n '1p')"
  set_state "failed" "complete" "Update failed safely (code $rc). Existing software was preserved or restored. See $LOG_FILE." "$target" "$backup"
  release_lock
  return 1
}

status_json() {
  local current latest released_at changelog checked_at available compatible current_ahead release_reachable
  local job_status job_stage job_message job_target job_backup job_updated
  load_config
  current="$(current_version)"
  latest="$(read_file "$CACHE_DIR/version" | sed -n '1p' | tr -d '\r\n')"
  [ -n "$latest" ] || latest="$current"
  released_at="$(read_file "$CACHE_DIR/released_at" | sed -n '1p' | tr -d '\r\n')"
  changelog="$(read_file "$CACHE_DIR/changelog")"
  checked_at="$(read_file "$CACHE_DIR/checked_at" | sed -n '1p' | tr -d '\r\n')"
  compatible="$(read_file "$CACHE_DIR/compatible" | sed -n '1p')"
  [ "$compatible" = "1" ] && compatible=true || compatible=false
  [ -n "$checked_at" ] && release_reachable=true || release_reachable=false
  available="false"
  [ "$compatible" = true ] && version_is_newer "$latest" "$current" && available="true"
  current_ahead=false
  version_is_newer "$current" "$latest" && current_ahead=true
  job_status="$(read_file "$STATE_DIR/status" | sed -n '1p')"
  [ -n "$job_status" ] || job_status="idle"
  job_stage="$(read_file "$STATE_DIR/stage" | sed -n '1p')"
  job_message="$(read_file "$STATE_DIR/message")"
  job_target="$(read_file "$STATE_DIR/target" | sed -n '1p')"
  job_backup="$(read_file "$STATE_DIR/backup" | sed -n '1p')"
  job_updated="$(read_file "$STATE_DIR/updated_at" | sed -n '1p')"

  printf '{"ok":true,"current":'
  json_string "$current"
  printf ',"latest":'
  json_string "$latest"
  printf ',"released_at":'
  json_string "$released_at"
  printf ',"changelog":'
  json_string "$changelog"
  printf ',"checked_at":'
  json_string "$checked_at"
  printf ',"available":%s,"compatible_release":%s,"release_reachable":%s,"current_ahead":%s,"auto_update":%s,"auto_schedule":' \
    "$available" "$compatible" "$release_reachable" "$current_ahead" "$([ "$AUTO_UPDATE" = "1" ] && printf true || printf false)"
  json_string "$AUTO_SCHEDULE"
  printf ',"job":{"status":'
  json_string "$job_status"
  printf ',"stage":'
  json_string "$job_stage"
  printf ',"message":'
  json_string "$job_message"
  printf ',"target":'
  json_string "$job_target"
  printf ',"backup":'
  json_string "$job_backup"
  printf ',"updated_at":'
  json_string "$job_updated"
  printf '}}\n'
}

auto_update() {
  local current latest compatible
  load_config
  [ "$AUTO_UPDATE" = "1" ] || exit 0
  check_worker || exit 1
  current="$(current_version)"
  latest="$(read_file "$CACHE_DIR/version" | sed -n '1p' | tr -d '\r\n')"
  compatible="$(read_file "$CACHE_DIR/compatible" | sed -n '1p')"
  [ "$compatible" = "1" ] || exit 0
  [ -n "$latest" ] && version_is_newer "$latest" "$current" || exit 0
  apply_worker
}

case "${1:-status}" in
  status) status_json ;;
  check-start) start_worker check ;;
  check-worker) check_worker ;;
  apply-start) start_worker apply ;;
  apply-worker) apply_worker ;;
  auto) auto_update ;;
  set-auto) set_auto_update "${2:-}" ;;
  configure-cron) configure_cron ;;
  clear-state) clear_state; status_json ;;
  *) die_json "unknown update action: ${1:-}" ;;
esac
