xray_test() {
  local config="$1"
  "$XRAY_BIN" run -test -config "$config" >/tmp/vpn-ui-xray-test.log 2>&1
}

restart_xray() {
  [ -x "${ROOT_PREFIX}/etc/init.d/$XRAY_SERVICE" ] || return 1
  "${ROOT_PREFIX}/etc/init.d/$XRAY_SERVICE" restart >/tmp/vpn-ui-xray-restart.log 2>&1 &&
    service_running "$XRAY_SERVICE"
}

update_transparent_endpoint() {
  local ip="$1"
  local ts="$2"
  local tmp
  local init_actual

  init_actual="$(managed_state_path "$TRANSPARENT_INIT")" || return 1
  [ -f "$init_actual" ] || return 0
  grep -q '^[[:space:]]*FIN0_IP=' "$init_actual" || return 0
  tmp="$init_actual.new.$$"
  sed 's/^[[:space:]]*FIN0_IP=.*/FIN0_IP="'"$ip"'"/' "$init_actual" > "$tmp" ||
    return 1
  chmod 755 "$tmp" && mv "$tmp" "$init_actual"
}

active_xray_service() {
  local service script path_matches="" running_matches="" available=""
  local path_count=0 running_count=0 available_count=0

  for service in xray xray-exit-st; do
    script="${ROOT_PREFIX}/etc/init.d/$service"
    [ -x "$script" ] || continue
    available="$service"
    available_count=$((available_count + 1))
    if [ -n "$ACTIVE_XRAY_CONFIG" ] && grep -Fq "$ACTIVE_XRAY_CONFIG" "$script" 2>/dev/null; then
      path_matches="$service"
      path_count=$((path_count + 1))
      if service_running "$service"; then
        running_matches="$service"
        running_count=$((running_count + 1))
      fi
    fi
  done

  if [ "$path_count" -eq 1 ]; then
    printf '%s' "$path_matches"
    return 0
  fi
  if [ "$path_count" -gt 1 ]; then
    [ "$running_count" -eq 1 ] || return 1
    printf '%s' "$running_matches"
    return 0
  fi

  running_matches=""
  running_count=0
  for service in xray xray-exit-st; do
    [ -x "${ROOT_PREFIX}/etc/init.d/$service" ] || continue
    if service_running "$service"; then
      running_matches="$service"
      running_count=$((running_count + 1))
    fi
  done
  if [ "$running_count" -eq 1 ]; then
    printf '%s' "$running_matches"
    return 0
  fi
  [ "$running_count" -eq 0 ] && [ "$available_count" -eq 1 ] || return 1
  printf '%s' "$available"
}

service_running() {
  local service="$1"
  "${ROOT_PREFIX}/etc/init.d/$service" running >/dev/null 2>&1
}

service_enabled() {
  local service="$1"
  "${ROOT_PREFIX}/etc/init.d/$service" enabled >/dev/null 2>&1
}

transparent_running() {
  [ -x "${ROOT_PREFIX}/etc/init.d/xray-transparent" ] || return 1
  service_running xray-transparent
}

xray_gate_state() {
  local value
  if [ "$XRAY_SERVICE" != xray ] || ! command -v "$UCI_BIN" >/dev/null 2>&1; then
    printf 'not-applicable'
    return 0
  fi
  if value="$("$UCI_BIN" -q get xray.enabled.enabled 2>/dev/null)"; then
    case "$value" in
      0|1) printf '%s' "$value" ;;
      *) return 1 ;;
    esac
  else
    printf 'absent'
  fi
}

set_xray_gate_state() {
  local expected="$1" actual
  case "$expected" in
    not-applicable) return 0 ;;
    absent)
      "$UCI_BIN" -q delete xray.enabled.enabled >/dev/null 2>&1 || true
      "$UCI_BIN" commit xray >/dev/null 2>&1 || return 1
      actual="$("$UCI_BIN" -q get xray.enabled.enabled 2>/dev/null || true)"
      [ -z "$actual" ]
      ;;
    0|1)
      "$UCI_BIN" set "xray.enabled.enabled=$expected" >/dev/null 2>&1 &&
        "$UCI_BIN" commit xray >/dev/null 2>&1 || return 1
      [ "$("$UCI_BIN" -q get xray.enabled.enabled 2>/dev/null || true)" = "$expected" ]
      ;;
    *) return 1 ;;
  esac
}

set_service_enabled_state() {
  local service="$1" expected="$2"
  if [ "$expected" = true ]; then
    service_enabled "$service" ||
      "${ROOT_PREFIX}/etc/init.d/$service" enable >/dev/null 2>&1 || return 1
    service_enabled "$service"
  else
    service_enabled "$service" &&
      "${ROOT_PREFIX}/etc/init.d/$service" disable >/dev/null 2>&1 || true
    ! service_enabled "$service"
  fi
}

set_service_running_state() {
  local service="$1" expected="$2"
  if [ "$expected" = true ]; then
    service_running "$service" ||
      "${ROOT_PREFIX}/etc/init.d/$service" start >/dev/null 2>&1 || return 1
    service_running "$service"
  else
    service_running "$service" &&
      "${ROOT_PREFIX}/etc/init.d/$service" stop >/dev/null 2>&1 || true
    ! service_running "$service"
  fi
}

set_transparent_running_state() {
  local expected="$1"
  if [ "$expected" = true ]; then
    transparent_running ||
      "${ROOT_PREFIX}/etc/init.d/xray-transparent" start >/dev/null 2>&1 || return 1
    transparent_running
  else
    transparent_running &&
      "${ROOT_PREFIX}/etc/init.d/xray-transparent" stop >/dev/null 2>&1 || true
    ! transparent_running
  fi
}

restore_xray_lifecycle_state() {
  local gate="$1" xray_enabled="$2" xray_running="$3"
  local transparent_enabled="$4" transparent_was_running="$5" failed=0

  if [ "$xray_running" = true ] && [ "$gate" != not-applicable ]; then
    set_xray_gate_state 1 || failed=1
  fi
  set_service_running_state "$XRAY_SERVICE" "$xray_running" || failed=1
  set_transparent_running_state "$transparent_was_running" || failed=1
  set_service_enabled_state "$XRAY_SERVICE" "$xray_enabled" || failed=1
  set_service_enabled_state xray-transparent "$transparent_enabled" || failed=1
  set_xray_gate_state "$gate" || failed=1

  [ "$(xray_gate_state 2>/dev/null || printf invalid)" = "$gate" ] || failed=1
  if [ "$xray_running" = true ]; then service_running "$XRAY_SERVICE" || failed=1
  else service_running "$XRAY_SERVICE" && failed=1; fi
  if [ "$transparent_was_running" = true ]; then transparent_running || failed=1
  else transparent_running && failed=1; fi
  if [ "$xray_enabled" = true ]; then service_enabled "$XRAY_SERVICE" || failed=1
  else service_enabled "$XRAY_SERVICE" && failed=1; fi
  if [ "$transparent_enabled" = true ]; then service_enabled xray-transparent || failed=1
  else service_enabled xray-transparent && failed=1; fi
  [ "$failed" = 0 ]
}

adopted_xray_test() {
  local config="$1" bin
  bin="${VPN_UI_XRAY_BIN:-}"
  if [ -z "$bin" ] && [ -x "${ROOT_PREFIX}/usr/local/bin/xray-latest" ]; then
    bin="${ROOT_PREFIX}/usr/local/bin/xray-latest"
  fi
  if [ -z "$bin" ] && [ -z "$ROOT_PREFIX" ] && command -v xray >/dev/null 2>&1; then
    bin="$(command -v xray)"
  fi
  [ -n "$bin" ] && [ -x "$bin" ] || return 1
  "$bin" run -test -config "$config" >"/tmp/vpn-ui-adopted-xray-test.$$" 2>&1
}

tailscale_invariant_snapshot() {
  local output="$1" status_file="/tmp/vpn-ui-tailscale-invariant.$$" backend="" ip4=""
  local tailscale_pid first_pid start_id enabled route_hash rule_hash prefs control tailnet
  local management_route_hash management_rule_hash state_file state_hash

  if [ "${PREMIER_ROUTER_HOST_TEST:-0}" = 1 ] &&
    [ -n "${VPN_UI_TEST_TAILSCALE_SNAPSHOT:-}" ]; then
    case "$output" in
      *tailscale-after.txt)
        printf '%s\n' "${VPN_UI_TEST_TAILSCALE_SNAPSHOT_AFTER:-$VPN_UI_TEST_TAILSCALE_SNAPSHOT}" > "$output"
        ;;
      *) printf '%s\n' "$VPN_UI_TEST_TAILSCALE_SNAPSHOT" > "$output" ;;
    esac
    return 0
  fi

  tailscale_pid="$(tailscale_daemon_pids)"
  first_pid="${tailscale_pid%% *}"
  start_id=""
  [ -z "$first_pid" ] || start_id="$(overlay_process_start_id "$first_pid" 2>/dev/null || true)"
  enabled=false
  [ -x "${ROOT_PREFIX}/etc/init.d/tailscale" ] &&
    "${ROOT_PREFIX}/etc/init.d/tailscale" enabled >/dev/null 2>&1 && enabled=true
  tailnet=""
  prefs=""
  control=""
  if [ -n "$first_pid" ] && command -v tailscale >/dev/null 2>&1; then
    if tailscale status --json > "$status_file" 2>/dev/null; then
      backend="$(json_value "$status_file" '@.BackendState' '.BackendState')"
      tailnet="$(json_value "$status_file" '@.CurrentTailnet.Name' '.CurrentTailnet.Name')"
    fi
    ip4="$(tailscale ip -4 2>/dev/null | sed -n '1p')"
    prefs="$(tailscale debug prefs 2>/dev/null || true)"
    control="$(printf '%s\n' "$prefs" | jsonfilter -e '@.ControlURL' 2>/dev/null || true)"
  fi
  if command -v ip >/dev/null 2>&1; then
    route_hash="$(ip -4 route show table all 2>/dev/null | LC_ALL=C sort | sha256sum | awk '{print $1}')"
    rule_hash="$(ip -4 rule show 2>/dev/null | LC_ALL=C sort | sha256sum | awk '{print $1}')"
    management_route_hash="$(ip -4 route show table main 2>/dev/null | grep -v 'tailscale0' | LC_ALL=C sort | sha256sum | awk '{print $1}')"
    management_rule_hash="$(ip -4 rule show 2>/dev/null |
      grep -Ev 'lookup (52|tailscale)|tailscale0|fwmark 0x80000/0xff0000' |
      LC_ALL=C sort | sha256sum | awk '{print $1}')"
  else
    route_hash=unavailable
    rule_hash=unavailable
    management_route_hash=unavailable
    management_rule_hash=unavailable
  fi
  state_file="$(tailscale_state_path)"
  state_hash=absent
  [ -f "$state_file" ] && [ ! -L "$state_file" ] &&
    state_hash="$(sha256sum "$state_file" | awk '{print $1}')"
  rm -f "$status_file"
  {
    printf 'pid=%s\n' "$tailscale_pid"
    printf 'process_start_id=%s\n' "$start_id"
    printf 'enabled=%s\n' "$enabled"
    printf 'backend=%s\n' "$backend"
    printf 'ip4=%s\n' "$ip4"
    printf 'control_url=%s\n' "$control"
    printf 'tailnet=%s\n' "$tailnet"
    printf 'route_hash=%s\n' "$route_hash"
    printf 'rule_hash=%s\n' "$rule_hash"
    printf 'management_route_hash=%s\n' "$management_route_hash"
    printf 'management_rule_hash=%s\n' "$management_rule_hash"
    printf 'state_hash=%s\n' "$state_hash"
  } > "$output"
}

tailscale_daemon_pids() {
  local proc_root pid command found=""
  proc_root="${VPN_UI_PROC_ROOT:-${ROOT_PREFIX}/proc}"
  [ -d "$proc_root" ] || proc_root=/proc
  for pid in $(pidof tailscaled 2>/dev/null || true); do
    [ -r "$proc_root/$pid/cmdline" ] || continue
    command="$(tr '\000' '\n' < "$proc_root/$pid/cmdline" 2>/dev/null | sed -n '1p')"
    case "${command##*/}" in tailscaled) ;; *) continue ;; esac
    if [ -z "$found" ]; then
      found="$pid"
    else
      found="$found $pid"
    fi
  done
  printf '%s\n' "$found"
}

tailscale_state_path() {
  local path
  path="$("$UCI_BIN" -q get tailscale.settings.state_file 2>/dev/null || true)"
  [ -n "$path" ] || path=/var/lib/tailscale/tailscaled.state
  case "$path" in /*) ;; *) return 1 ;; esac
  case "$path" in *'/../'*|*/..|../*|*'/./'*|*/.) return 1 ;; esac
  host_path "$path"
}

tailscale_snapshot_value() {
  sed -n "s/^$2=//p" "$1" | sed -n '1p'
}

tailscale_action_begin() {
  local snapshot="$1" transaction="$2" state_file
  [ ! -e "$transaction" ] && [ ! -L "$transaction" ] || return 1
  mkdir "$transaction" || return 1
  chmod 700 "$transaction" || return 1
  tailscale_invariant_snapshot "$snapshot" || return 1
  state_file="$(tailscale_state_path)" || return 1
  [ ! -L "$state_file" ] || return 1
  printf '%s\n' "$state_file" > "$transaction/state.path"
  chmod 600 "$transaction/state.path"
  if [ -f "$state_file" ] && [ ! -L "$state_file" ]; then
    cp -p "$state_file" "$transaction/state.preimage" || return 1
    chmod 600 "$transaction/state.preimage"
  else
    : > "$transaction/state.absent"
  fi
}

tailscale_backend_stable() {
  case "$1" in Running|NeedsLogin|NeedsMachineAuth|Stopped|NoState) return 0 ;; esac
  return 1
}

tailscale_wait_state() {
  local expected_running="$1" expected_enabled="$2" expected_backend="$3" expected_ip="$4"
  local timeout="$5" old_pid="${6:-}" old_start="${7:-}" require_new="${8:-false}"
  local attempt=0 observed="/tmp/vpn-ui-tailscale-wait.$$" running enabled backend ip pid start matches
  case "$timeout" in ''|*[!0-9]*) return 1 ;; esac
  while [ "$attempt" -lt "$timeout" ]; do
    tailscale_invariant_snapshot "$observed" || return 1
    pid="$(tailscale_snapshot_value "$observed" pid)"
    start="$(tailscale_snapshot_value "$observed" process_start_id)"
    [ -n "$pid" ] && running=true || running=false
    enabled="$(tailscale_snapshot_value "$observed" enabled)"
    backend="$(tailscale_snapshot_value "$observed" backend)"
    ip="$(tailscale_snapshot_value "$observed" ip4)"
    matches=true
    [ "$running" = "$expected_running" ] || matches=false
    [ "$enabled" = "$expected_enabled" ] || matches=false
    if [ "$expected_backend" = any-stable ]; then
      tailscale_backend_stable "$backend" || matches=false
    elif [ -n "$expected_backend" ] && [ "$backend" != "$expected_backend" ]; then
      matches=false
    fi
    case "$expected_ip" in
      nonempty) [ -n "$ip" ] || matches=false ;;
      empty) [ -z "$ip" ] || matches=false ;;
      '') ;;
      *) [ "$ip" = "$expected_ip" ] || matches=false ;;
    esac
    if [ "$require_new" = true ] && [ "$old_pid:$old_start" = "$pid:$start" ]; then
      matches=false
    fi
    if [ "$matches" = true ]; then
      rm -f "$observed"
      return 0
    fi
    attempt=$((attempt + 1))
    [ "$attempt" -ge "$timeout" ] || sleep 1
  done
  rm -f "$observed"
  return 1
}

tailscale_snapshot_matches_restored() {
  local before="$1" after="$2" key
  for key in enabled backend ip4 control_url tailnet route_hash rule_hash \
    management_route_hash management_rule_hash; do
    [ "$(tailscale_snapshot_value "$before" "$key")" = \
      "$(tailscale_snapshot_value "$after" "$key")" ] || return 1
  done
  if [ -n "$(tailscale_snapshot_value "$before" pid)" ]; then
    [ -n "$(tailscale_snapshot_value "$after" pid)" ] || return 1
  else
    [ -z "$(tailscale_snapshot_value "$after" pid)" ] || return 1
  fi
}

tailscale_wait_invariants() {
  local before="$1" after="$2" mode="$3" timeout="$4" attempt=0 key matches
  case "$timeout" in ''|*[!0-9]*) return 1 ;; esac
  while [ "$attempt" -lt "$timeout" ]; do
    tailscale_invariant_snapshot "$after" || return 1
    matches=true
    case "$mode" in
      management) set -- management_route_hash management_rule_hash ;;
      restart) set -- control_url tailnet route_hash rule_hash management_route_hash management_rule_hash ;;
      *) return 1 ;;
    esac
    for key in "$@"; do
      [ "$(tailscale_snapshot_value "$before" "$key")" = \
        "$(tailscale_snapshot_value "$after" "$key")" ] || matches=false
    done
    [ "$matches" = true ] && return 0
    attempt=$((attempt + 1))
    [ "$attempt" -ge "$timeout" ] || sleep 1
  done
  return 1
}

tailscale_restore_prestate() {
  local before="$1" transaction="$2" state_file pre_running pre_enabled pre_backend pre_ip
  local after="$transaction/restored.txt" early="$transaction/restored-early.txt" attempt=0 state_same=false
  state_file="$(sed -n '1p' "$transaction/state.path" 2>/dev/null)"
  case "$state_file" in /*) ;; *) return 1 ;; esac
  case "$state_file" in *'/../'*|*/..|../*|*'/./'*|*/.) return 1 ;; esac
  [ ! -L "$state_file" ] || return 1
  pre_running=false
  [ -n "$(tailscale_snapshot_value "$before" pid)" ] && pre_running=true
  pre_enabled="$(tailscale_snapshot_value "$before" enabled)"
  pre_backend="$(tailscale_snapshot_value "$before" backend)"
  pre_ip="$(tailscale_snapshot_value "$before" ip4)"
  if [ "$pre_enabled" = true ]; then
    "${ROOT_PREFIX}/etc/init.d/tailscale" enable >/tmp/vpn-ui-tailscale-restore.log 2>&1 || return 1
  else
    "${ROOT_PREFIX}/etc/init.d/tailscale" disable >/tmp/vpn-ui-tailscale-restore.log 2>&1 || return 1
  fi
  if [ -f "$transaction/state.absent" ]; then
    [ ! -e "$state_file" ] && state_same=true
  else
    [ -f "$transaction/state.preimage" ] || return 1
    cmp -s "$transaction/state.preimage" "$state_file" && state_same=true
  fi
  if [ "$state_same" = true ]; then
    tailscale_invariant_snapshot "$early" || return 1
    tailscale_snapshot_matches_restored "$before" "$early" && return 0
  fi
  set_service_running_state tailscale false || return 1
  if [ -f "$transaction/state.absent" ]; then
    rm -f "$state_file"
  else
    mkdir -p "$(dirname "$state_file")" || return 1
    cp -p "$transaction/state.preimage" "$state_file" || return 1
    cmp -s "$transaction/state.preimage" "$state_file" || return 1
  fi
  if [ "$pre_running" = true ]; then
    "${ROOT_PREFIX}/etc/init.d/tailscale" start >/tmp/vpn-ui-tailscale-restore.log 2>&1 || return 1
  fi
  tailscale_wait_state "$pre_running" "$pre_enabled" "$pre_backend" "$pre_ip" \
    "${VPN_UI_TAILSCALE_RESTORE_TIMEOUT:-20}" || return 1
  while [ "$attempt" -lt "${VPN_UI_TAILSCALE_RESTORE_TIMEOUT:-20}" ]; do
    tailscale_invariant_snapshot "$after" || return 1
    tailscale_snapshot_matches_restored "$before" "$after" && return 0
    attempt=$((attempt + 1))
    [ "$attempt" -ge "${VPN_UI_TAILSCALE_RESTORE_TIMEOUT:-20}" ] || sleep 1
  done
  return 1
}

tailscale_action_failed() {
  local action="$1" before="$2" transaction="$3" reason="$4"
  if tailscale_restore_prestate "$before" "$transaction"; then
    rm -rf "$transaction"
    die_json "$action failed; exact pre-action Tailscale state was restored: $reason"
  fi
  die_json "$action failed and exact pre-action Tailscale state restoration could not be proven: $reason"
}

restore_transparent_state() {
  local expected="$1" actual=false
  transparent_running && actual=true
  if [ "$expected" = true ]; then
    "${ROOT_PREFIX}/etc/init.d/xray-transparent" restart >/tmp/vpn-ui-transparent-restore.log 2>&1 || return 1
  elif [ "$expected" = false ] && [ "$actual" = true ]; then
    "${ROOT_PREFIX}/etc/init.d/xray-transparent" stop >/tmp/vpn-ui-transparent-restore.log 2>&1 || return 1
  fi
  if [ "$expected" = true ]; then transparent_running; else ! transparent_running; fi
}

overlay_test_boundary() {
  [ "${PREMIER_ROUTER_HOST_TEST:-0}" = 1 ] || return 0
  [ "${VPN_UI_TEST_ADOPT_FAIL_AFTER:-}" = "$1" ] || return 0
  return 97
}

overlay_test_crash() {
  [ "${PREMIER_ROUTER_HOST_TEST:-0}" = 1 ] || return 0
  [ "${VPN_UI_TEST_ADOPT_CRASH_AFTER:-}" = "$1" ] || return 0
  exit 99
}

overlay_test_external_drift() {
  local phase="$1" target="$2" source="${VPN_UI_TEST_ADOPT_DRIFT_FILE:-}"
  [ "${PREMIER_ROUTER_HOST_TEST:-0}" = 1 ] || return 0
  [ "${VPN_UI_TEST_ADOPT_DRIFT_BEFORE:-}" = "$phase" ] || return 0
  [ -f "$source" ] || return 1
  cp "$source" "$target"
}

restore_adopted_preimage() {
  local transaction="$1" config_actual="$2" service="$3" xray_was_running="$4"
  local transparent_was_running="$5" policy="${6:-if-candidate}" tmp failed=0
  local current_hash preimage_hash candidate_hash config_restored=false after_snapshot

  managed_target_safe "$config_actual" || failed=1
  if [ "$failed" = 0 ] && [ "$policy" != never ]; then
    current_hash="$(sha256sum "$config_actual" 2>/dev/null | awk '{print $1}')"
    preimage_hash="$(sha256sum "$transaction/config.preimage" 2>/dev/null | awk '{print $1}')"
    candidate_hash="$(sed -n '1p' "$transaction/candidate.sha256" 2>/dev/null)"
    if [ -n "$candidate_hash" ] && [ "$current_hash" = "$candidate_hash" ]; then
      tmp="$config_actual.restore.$$"
      cp -p "$transaction/config.preimage" "$tmp" && mv "$tmp" "$config_actual" || failed=1
      [ "$failed" = 0 ] && config_restored=true
    elif [ "$current_hash" != "$preimage_hash" ]; then
      failed=1
    fi
  fi
  restore_optional_file "$(managed_state_path "$DOMAINS_FILE")" domains.preimage "$transaction" || failed=1
  restore_optional_file "$(managed_state_path "$IPS_FILE")" ips.preimage "$transaction" || failed=1
  restore_optional_file "$OWNERSHIP_STATE" ownership.preimage "$transaction" || failed=1
  restore_optional_file "$(managed_state_path "$SELECTED_FILE")" selected.preimage "$transaction" || failed=1
  restore_optional_file "$(host_path "$TRANSPARENT_INIT")" transparent-init.preimage "$transaction" || failed=1
  if [ "$config_restored" = true ]; then
    case "$service" in *[!A-Za-z0-9_-]*|'') failed=1 ;; esac
    if [ "$failed" = 0 ] && [ "$xray_was_running" = true ]; then
      "${ROOT_PREFIX}/etc/init.d/$service" restart >"/tmp/vpn-ui-xray-rollback.$$" 2>&1 || failed=1
      [ "$failed" = 0 ] && service_running "$service" || failed=1
    elif [ "$failed" = 0 ]; then
      set_service_running_state "$service" false || failed=1
    fi
    restore_transparent_state "$transparent_was_running" || failed=1
  fi
  if [ "$config_restored" = true ]; then
    cmp -s "$transaction/config.preimage" "$config_actual" || failed=1
  fi
  if [ -f "$transaction/tailscale-before.txt" ]; then
    after_snapshot="$transaction/tailscale-after-rollback.txt"
    tailscale_invariant_snapshot "$after_snapshot" || failed=1
    cmp -s "$transaction/tailscale-before.txt" "$after_snapshot" || failed=1
  fi
  if [ -f "$transaction/candidate.path" ]; then
    OVERLAY_CANDIDATE="$(sed -n '1p' "$transaction/candidate.path")"
    case "$OVERLAY_CANDIDATE" in
      "${ROOT_PREFIX}/etc/xray/".*.vpn-ui-candidate.*) rm -f "$OVERLAY_CANDIDATE" ;;
    esac
    OVERLAY_CANDIDATE=""
  fi
  [ "$failed" = 0 ]
}

write_adopted_profile_input() {
  local output="$1" old_vps_ip="$2"

  is_ipv4 "$old_vps_ip" || return 1
  is_ipv4 "$P_VPS_IP" || return 1
  cat > "$output" <<EOF
{"address":"$(json_config_escape "$P_HOST")","port":$P_PORT,"uuid":"$(json_config_escape "$P_UUID")","flow":"$(json_config_escape "$P_FLOW")","server_name":"$(json_config_escape "$P_SNI")","fingerprint":"$(json_config_escape "$P_FINGERPRINT")","public_key":"$(json_config_escape "$P_PUBLIC_KEY")","short_id":"$(json_config_escape "$P_SHORT_ID")","spider_x":"$(json_config_escape "$P_SPIDERX")","old_vps_ip":"$old_vps_ip","new_vps_ip":"$P_VPS_IP"}
EOF
  chmod 600 "$output"
}

apply_adopted_rules() {
  local domains_src="$1" ips_src="$2" profile_id="${3:-}" config_actual config_dir candidate service
  local actual_hash candidate_hash adopted_at domain_count ip_count required available
  local xray_was_running=false transparent_was_running=false failure="" mode uid gid
  local before_snapshot after_snapshot rollback_policy=never old_selected="" old_vps_ip=""
  local profile_input="" selected_input="" ts overlay_rc=0

  require_update_committed_for_mutation
  overlay_lock_acquire || die_json "another adopted-overlay transaction is active"
  overlay_recover_transactions || die_json "unfinished adopted-overlay transaction requires recovery"
  adoption_state_load || die_json "adopted-overlay state is missing or invalid"
  discover_active_xray_config || die_json "$ACTIVE_XRAY_DISCOVERY_ERROR"
  [ "$ACTIVE_XRAY_CONFIG" = "$OWNERSHIP_PATH" ] ||
    die_json "active Xray configuration path drifted from the adopted path"
  safe_adopted_config_file "$OWNERSHIP_PATH" ||
    die_json "adopted Xray configuration path is unsafe, missing, or symlinked"
  actual_hash="$(config_sha256 "$OWNERSHIP_PATH")"
  [ "$actual_hash" = "$OWNERSHIP_CONFIG_HASH" ] ||
    die_json "adopted Xray configuration bytes changed outside Router UI; preview and adopt again"
  if [ -n "$profile_id" ]; then
    old_selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"
    [ -n "$old_selected" ] || die_json "no selected VLESS profile"
    load_profile_id "$old_selected"
    old_vps_ip="$(detect_vps_ip_from_transparent)"
    [ -n "$old_vps_ip" ] || old_vps_ip="$P_VPS_IP"
    load_profile_id "$profile_id"
  fi
  validate_domain_rules_file "$domains_src" 2>"/tmp/vpn-ui-domain-validation.$$" ||
    die_json "domain rule validation failed: $(cat "/tmp/vpn-ui-domain-validation.$$" 2>/dev/null)"
  validate_ip_rules_file "$ips_src" 2>"/tmp/vpn-ui-ip-validation.$$" ||
    die_json "IP rule validation failed: $(cat "/tmp/vpn-ui-ip-validation.$$" 2>/dev/null)"
  ensure_domain_rule_data "$domains_src"

  config_actual="$(host_path "$OWNERSHIP_PATH")"
  config_dir="$(dirname "$config_actual")"
  candidate="$config_dir/.$(basename "$config_actual").vpn-ui-candidate.$$.json"
  new_overlay_transaction apply "$OWNERSHIP_PATH" ||
    die_json "could not create private apply journal"
  cp -p "$config_actual" "$OVERLAY_TRANSACTION/config.preimage" &&
    backup_optional_file "$(managed_state_path "$DOMAINS_FILE")" domains.preimage "$OVERLAY_TRANSACTION" &&
    backup_optional_file "$(managed_state_path "$IPS_FILE")" ips.preimage "$OVERLAY_TRANSACTION" &&
    backup_optional_file "$OWNERSHIP_STATE" ownership.preimage "$OVERLAY_TRANSACTION" &&
    backup_optional_file "$(managed_state_path "$SELECTED_FILE")" selected.preimage "$OVERLAY_TRANSACTION" &&
    backup_optional_file "$(host_path "$TRANSPARENT_INIT")" transparent-init.preimage "$OVERLAY_TRANSACTION" ||
      die_json "could not preserve exact adopted-overlay preimages"
  printf '%s\n' "$candidate" > "$OVERLAY_TRANSACTION/candidate.path"
  chmod 600 "$OVERLAY_TRANSACTION/candidate.path"
  OVERLAY_CANDIDATE="$candidate"
  if [ -n "$profile_id" ]; then
    profile_input="$OVERLAY_TRANSACTION/profile.json"
    selected_input="$OVERLAY_TRANSACTION/selected.new"
    write_adopted_profile_input "$profile_input" "$old_vps_ip" ||
      die_json "could not prepare the adopted VLESS profile overlay"
    printf '%s\n' "$profile_id" > "$selected_input"
    chmod 600 "$selected_input"
  fi
  if [ -n "$profile_id" ]; then
    overlay_exec patch-profile "$config_actual" "$OWNERSHIP_DOMAIN_INDEX" "$OWNERSHIP_IP_INDEX" \
      "$domains_src" "$ips_src" "$candidate" "$profile_input" \
      >"/tmp/vpn-ui-overlay-result.$$" 2>&1 || overlay_rc=$?
  else
    overlay_exec patch "$config_actual" "$OWNERSHIP_DOMAIN_INDEX" "$OWNERSHIP_IP_INDEX" \
      "$domains_src" "$ips_src" "$candidate" >"/tmp/vpn-ui-overlay-result.$$" 2>&1 || overlay_rc=$?
  fi
  if [ "$overlay_rc" -ne 0 ]; then
    overlay_journal_write "$OVERLAY_TRANSACTION" failed_before_mutation "structural overlay failed" || true
    die_json "structural Xray overlay failed: $(cat "/tmp/vpn-ui-overlay-result.$$" 2>/dev/null)"
  fi
  mode="$(stat -c '%a' "$config_actual" 2>/dev/null ||
    stat -f '%Lp' "$config_actual" 2>/dev/null || printf 600)"
  uid="$(stat -c '%u' "$config_actual" 2>/dev/null ||
    stat -f '%u' "$config_actual" 2>/dev/null || printf 0)"
  gid="$(stat -c '%g' "$config_actual" 2>/dev/null ||
    stat -f '%g' "$config_actual" 2>/dev/null || printf 0)"
  chmod "$mode" "$candidate" || die_json "could not preserve Xray configuration mode"
  chown "$uid:$gid" "$candidate" 2>/dev/null || {
    die_json "could not preserve Xray configuration ownership"
  }
  adopted_xray_test "$candidate" || {
    die_json "Xray validation failed: $(cat "/tmp/vpn-ui-adopted-xray-test.$$" 2>/dev/null)"
  }
  candidate_hash="$(sha256sum "$candidate" | awk '{print $1}')"
  printf '%s\n' "$candidate_hash" > "$OVERLAY_TRANSACTION/candidate.sha256"
  chmod 600 "$OVERLAY_TRANSACTION/candidate.sha256"
  domain_count="$(awk 'NF && $0 !~ /^[[:space:]]*#/ {count++} END {print count+0}' "$domains_src")"
  ip_count="$(awk 'NF && $0 !~ /^[[:space:]]*#/ {count++} END {print count+0}' "$ips_src")"
  required=$(( $(wc -c < "$config_actual") + $(wc -c < "$candidate") +
    $(file_bytes "$(managed_state_path "$DOMAINS_FILE")") + $(file_bytes "$(managed_state_path "$IPS_FILE")") +
    $(file_bytes "$OWNERSHIP_STATE") + $(file_bytes "$profile_input") +
    $(file_bytes "$(managed_state_path "$SELECTED_FILE")") + $(file_bytes "$(host_path "$TRANSPARENT_INIT")") +
    $(wc -c < "$domains_src") + $(wc -c < "$ips_src") +
    ADOPT_STORAGE_MARGIN_BYTES ))
  if ! overlay_storage_gate "$config_actual" "$required"; then
    available="${OVERLAY_AVAILABLE_BYTES:-unknown}"
    overlay_journal_write "$OVERLAY_TRANSACTION" failed_before_mutation "storage reservation failed" || true
    die_json "adopted-overlay apply requires $required free bytes including margin; available: $available"
  fi

  service="$(active_xray_service)" || die_json "Xray init service is unavailable"
  service_running "$service" && xray_was_running=true
  transparent_running && transparent_was_running=true
  OVERLAY_SERVICE="$service"
  OVERLAY_XRAY_WAS_RUNNING="$xray_was_running"
  OVERLAY_TRANSPARENT_WAS_RUNNING="$transparent_was_running"
  before_snapshot="$OVERLAY_TRANSACTION/tailscale-before.txt"
  after_snapshot="$OVERLAY_TRANSACTION/tailscale-after.txt"
  tailscale_invariant_snapshot "$before_snapshot" || failure="could not capture pre-apply Tailscale invariants"
  if [ -z "$failure" ]; then
    overlay_journal_write "$OVERLAY_TRANSACTION" prepared ||
      failure="could not create the private apply journal"
  fi
  overlay_test_boundary after-backup || failure="injected failure after backup"

  if [ -z "$failure" ]; then
    overlay_journal_write "$OVERLAY_TRANSACTION" rules_committing ||
      failure="could not durably enter route-list mutation phase"
  fi
  [ -n "$failure" ] || overlay_test_external_drift domain "$config_actual" ||
    failure="could not inject domain-list TOCTOU drift"
  if [ -z "$failure" ] && [ "$(config_sha256 "$OWNERSHIP_PATH")" != "$actual_hash" ]; then
    failure="Xray configuration changed immediately before domain-list commit"
  fi
  if [ -z "$failure" ]; then
    install_managed_file "$domains_src" "$(managed_state_path "$DOMAINS_FILE")" 600 || failure="domain rule-list commit failed"
  fi
  [ -n "$failure" ] || overlay_test_external_drift ip "$config_actual" ||
    failure="could not inject IP-list TOCTOU drift"
  if [ -z "$failure" ] && [ "$(config_sha256 "$OWNERSHIP_PATH")" != "$actual_hash" ]; then
    failure="Xray configuration changed immediately before IP-list commit"
  fi
  if [ -z "$failure" ]; then
    install_managed_file "$ips_src" "$(managed_state_path "$IPS_FILE")" 600 || failure="IP rule-list commit failed"
  fi
  if [ -z "$failure" ]; then
    overlay_journal_write "$OVERLAY_TRANSACTION" rules_committed ||
      failure="could not durably commit the route-list mutation phase"
  fi
  [ -n "$failure" ] || overlay_test_crash rules
  [ -n "$failure" ] || overlay_test_boundary after-rules || failure="injected failure after route-list commit"
  [ -n "$failure" ] || overlay_test_external_drift config "$config_actual" ||
    failure="could not inject configuration TOCTOU drift"
  if [ -z "$failure" ] && [ "$(config_sha256 "$OWNERSHIP_PATH")" != "$actual_hash" ]; then
    failure="Xray configuration changed immediately before live configuration commit"
  fi
  if [ -z "$failure" ]; then
    OVERLAY_RESTORE_CONFIG=true
    overlay_journal_write "$OVERLAY_TRANSACTION" config_committing ||
      failure="could not durably enter configuration mutation phase"
  fi
  [ -n "$failure" ] || overlay_test_external_drift config-final "$config_actual" ||
    failure="could not inject final configuration TOCTOU drift"
  if [ -z "$failure" ] && [ "$(config_sha256 "$OWNERSHIP_PATH")" != "$actual_hash" ]; then
    OVERLAY_RESTORE_CONFIG=false
    overlay_journal_write "$OVERLAY_TRANSACTION" rules_committed \
      "external configuration drift detected before replacement" || true
    failure="Xray configuration changed immediately before live configuration replacement"
  fi
  if [ -z "$failure" ]; then
    mv "$candidate" "$config_actual" || failure="atomic Xray configuration commit failed"
    [ -n "$failure" ] || OVERLAY_CANDIDATE=""
  fi
  if [ -z "$failure" ]; then
    overlay_journal_write "$OVERLAY_TRANSACTION" config_committed ||
      failure="could not durably commit the configuration mutation phase"
  fi
  [ -n "$failure" ] || overlay_test_crash config
  [ -n "$failure" ] || overlay_test_boundary after-config || failure="injected failure after configuration commit"
  if [ -z "$failure" ] && [ "${PREMIER_ROUTER_HOST_TEST:-0}" = 1 ] &&
    [ "${VPN_UI_TEST_ADOPT_INVALID_AFTER_CONFIG:-0}" = 1 ]; then
    printf '%s\n' '{invalid-json' > "$config_actual"
    sha256sum "$config_actual" | awk '{print $1}' > "$OVERLAY_TRANSACTION/candidate.sha256"
  fi
  if [ -z "$failure" ]; then
    adopted_xray_test "$config_actual" ||
      failure="installed Xray validation failed: $(cat "/tmp/vpn-ui-adopted-xray-test.$$" 2>/dev/null)"
  fi
  if [ -z "$failure" ]; then
    overlay_journal_write "$OVERLAY_TRANSACTION" restarting ||
      failure="could not durably enter Xray restart phase"
  fi
  if [ -z "$failure" ] && [ -n "$profile_id" ]; then
    ts="$(date +%Y%m%d-%H%M%S)"
    update_transparent_endpoint "$P_VPS_IP" "$ts" ||
      failure="transparent endpoint update failed"
  fi
  if [ -z "$failure" ] && [ "$xray_was_running" = true ]; then
    "${ROOT_PREFIX}/etc/init.d/$service" restart >"/tmp/vpn-ui-xray-restart.$$" 2>&1 ||
      failure="Xray restart failed: $(cat "/tmp/vpn-ui-xray-restart.$$" 2>/dev/null)"
  fi
  if [ -z "$failure" ] && [ "$xray_was_running" = true ]; then
    service_running "$service" || failure="Xray restart returned without a running daemon"
  elif [ -z "$failure" ] && service_running "$service"; then
    failure="Xray was started by an adopted configuration-only operation"
  fi
  if [ -z "$failure" ]; then
    restore_transparent_state "$transparent_was_running" || failure="transparent routing state could not be restored"
  fi
  [ -n "$failure" ] || overlay_test_boundary after-restart || failure="injected failure after Xray restart"
  if [ -z "$failure" ]; then
    overlay_journal_write "$OVERLAY_TRANSACTION" runtime_validating ||
      failure="could not durably enter runtime invariant validation"
  fi
  if [ -z "$failure" ]; then
    tailscale_invariant_snapshot "$after_snapshot" || failure="could not capture post-apply Tailscale invariants"
  fi
  if [ -z "$failure" ] && ! cmp -s "$before_snapshot" "$after_snapshot"; then
    failure="Tailscale PID, enabled/connected state, identity, or return routing changed"
  fi
  if [ -z "$failure" ] && [ "$(config_sha256 "$OWNERSHIP_PATH")" != "$candidate_hash" ]; then
    failure="installed Xray configuration hash does not match the validated candidate"
  fi
  adopted_at="$(json_value "$OWNERSHIP_STATE" '@.adopted_at' '.adopted_at')"
  if [ -z "$failure" ]; then
    overlay_journal_write "$OVERLAY_TRANSACTION" state_committing ||
      failure="could not durably enter ownership-state mutation phase"
  fi
  [ -n "$failure" ] || overlay_test_external_drift state "$config_actual" ||
    failure="could not inject ownership-state TOCTOU drift"
  if [ -z "$failure" ] && [ "$(config_sha256 "$OWNERSHIP_PATH")" != "$candidate_hash" ]; then
    failure="Xray configuration changed immediately before ownership-state commit"
  fi
  if [ -z "$failure" ]; then
    write_ownership_state "$OWNERSHIP_PATH" "$candidate_hash" "$OWNERSHIP_DOMAIN_INDEX" \
      "$OWNERSHIP_IP_INDEX" "$domain_count" "$ip_count" "$adopted_at" ||
      failure="adopted-overlay management state commit failed"
  fi
  if [ -z "$failure" ] && [ -n "$profile_id" ]; then
    install_managed_file "$selected_input" "$(managed_state_path "$SELECTED_FILE")" 600 ||
      failure="selected VLESS profile state commit failed"
  fi
  [ -n "$failure" ] || overlay_test_boundary after-state || failure="injected failure after management-state commit"
  if [ -z "$failure" ]; then
    overlay_journal_write "$OVERLAY_TRANSACTION" committed ||
      failure="adopted-overlay journal commit failed"
  fi

  if [ -n "$failure" ]; then
    [ "$OVERLAY_RESTORE_CONFIG" = true ] && rollback_policy=if-candidate
    if restore_adopted_preimage "$OVERLAY_TRANSACTION" "$config_actual" "$service" \
      "$xray_was_running" "$transparent_was_running" "$rollback_policy"; then
      overlay_journal_write "$OVERLAY_TRANSACTION" rolled_back "$failure" || true
      if [ "$rollback_policy" = never ]; then
        die_json "$failure; route lists and management state restored while external Xray bytes were preserved"
      fi
      die_json "$failure; exact Xray configuration, route lists, and management state restored"
    fi
    overlay_journal_write "$OVERLAY_TRANSACTION" recovery_required "$failure" || true
    die_json "$failure; rollback_failed and physical/LAN recovery is required"
  fi
  overlay_cleanup_transactions || true
  overlay_lock_release || die_json "adopted-overlay apply completed but transaction lock release failed"
}

render_and_apply() {
  local id="$1"
  local domains_src="$2"
  local ips_src="$3"
  local commit_routes="$4"
  local ts tmpcfg transaction config_actual test_out failure="" rollback_failed=0
  local xray_was_running=false transparent_was_running=false

  init_state
  load_profile_id "$id"
  ts="$(date +%Y%m%d-%H%M%S)"
  tmpcfg="/tmp/vpn-ui-xray-$ts.$$.json"
  transaction="/tmp/vpn-ui-native-apply.$$.preimage"
  config_actual="$(host_path "$XRAY_CONFIG")" || die_json "Xray configuration path is unsafe"

  ensure_domain_rule_data "$domains_src"
  render_xray_config "$tmpcfg" "$domains_src" "$ips_src"
  if ! xray_test "$tmpcfg"; then
    test_out="$(cat /tmp/vpn-ui-xray-test.log 2>/dev/null || true)"
    rm -f "$tmpcfg"
    die_json "Xray validation failed: $(one_line "$test_out")"
  fi

  mkdir "$transaction" && chmod 700 "$transaction" || {
    rm -f "$tmpcfg"
    die_json "could not create the native Xray apply preimage"
  }
  backup_optional_file "$config_actual" config "$transaction" &&
    backup_optional_file "$DOMAINS_FILE" domains "$transaction" &&
    backup_optional_file "$IPS_FILE" ips "$transaction" &&
    backup_optional_file "$SELECTED_FILE" selected "$transaction" &&
    backup_optional_file "$(host_path "$TRANSPARENT_INIT")" transparent "$transaction" || {
      rm -f "$tmpcfg"
      rm -rf "$transaction"
      die_json "could not preserve exact native Xray pre-state"
    }
  service_running "$XRAY_SERVICE" && xray_was_running=true
  transparent_running && transparent_was_running=true

  install_managed_file "$tmpcfg" "$config_actual" 600 ||
    failure="atomic Xray configuration commit failed"
  rm -f "$tmpcfg"
  if [ -z "$failure" ] && [ "$commit_routes" = 1 ]; then
    install_managed_file "$domains_src" "$DOMAINS_FILE" 600 ||
      failure="domain rule-list commit failed"
  fi
  if [ -z "$failure" ] && [ "$commit_routes" = 1 ]; then
    install_managed_file "$ips_src" "$IPS_FILE" 600 ||
      failure="IP rule-list commit failed"
  fi
  [ -n "$failure" ] || update_transparent_endpoint "$P_VPS_IP" "$ts" ||
    failure="transparent endpoint update failed"
  if [ -z "$failure" ] && [ "$xray_was_running" = true ]; then
    restart_xray ||
      failure="Xray restart did not reach a running daemon: $(cat /tmp/vpn-ui-xray-restart.log 2>/dev/null)"
  elif [ -z "$failure" ] && service_running "$XRAY_SERVICE"; then
    failure="Xray was started by a configuration-only operation"
  fi
  if [ -z "$failure" ]; then
    restore_transparent_state "$transparent_was_running" ||
      failure="transparent routing did not preserve its pre-state"
  fi
  if [ -z "$failure" ]; then
    printf '%s\n' "$id" > "$transaction/selected.new" &&
      install_managed_file "$transaction/selected.new" "$SELECTED_FILE" 600 ||
      failure="selected VLESS profile state commit failed"
  fi

  if [ -n "$failure" ]; then
    restore_optional_file "$config_actual" config "$transaction" || rollback_failed=1
    restore_optional_file "$DOMAINS_FILE" domains "$transaction" || rollback_failed=1
    restore_optional_file "$IPS_FILE" ips "$transaction" || rollback_failed=1
    restore_optional_file "$SELECTED_FILE" selected "$transaction" || rollback_failed=1
    restore_optional_file "$(host_path "$TRANSPARENT_INIT")" transparent "$transaction" || rollback_failed=1
    if [ "$xray_was_running" = true ]; then
      restart_xray || rollback_failed=1
    else
      set_service_running_state "$XRAY_SERVICE" false || rollback_failed=1
    fi
    restore_transparent_state "$transparent_was_running" || rollback_failed=1
    rm -rf "$transaction"
    if [ "$rollback_failed" = 0 ]; then
      die_json "$failure; exact Xray configuration, route, selection, daemon, and transparent-proxy pre-state restored"
    fi
    die_json "$failure; native Xray rollback failed and recovery is required"
  fi
  rm -rf "$transaction"
}

format_duration() {
  local seconds="$1"
  local days hours mins secs out

  [ "$seconds" -gt 0 ] 2>/dev/null || {
    printf 'expired'
    return
  }

  days=$((seconds / 86400))
  seconds=$((seconds % 86400))
  hours=$((seconds / 3600))
  seconds=$((seconds % 3600))
  mins=$((seconds / 60))
  secs=$((seconds % 60))

  out=""
  [ "$days" -gt 0 ] && out="${out}${days}d "
  [ "$hours" -gt 0 ] && out="${out}${hours}h "
  [ "$mins" -gt 0 ] && out="${out}${mins}m "
  if [ -z "$out" ]; then
    out="${secs}s"
  fi
  printf '%s' "$(printf '%s' "$out" | sed 's/[[:space:]]*$//')"
}

device_mac_disabled() {
  local mac="$1"
  [ -f "$DEVICE_BYPASS_FILE" ] || return 1
  grep -iqxF "$mac" "$DEVICE_BYPASS_FILE" 2>/dev/null
}

append_disabled_mac() {
  local mac="$1"
  init_device_bypass_file
  device_mac_disabled "$mac" || printf '%s\n' "$mac" >> "$DEVICE_BYPASS_FILE"
}

delete_disabled_mac() {
  local mac="$1"
  local tmp="/tmp/vpn-ui-device-macs.$$"
  init_device_bypass_file
  grep -ivxF "$mac" "$DEVICE_BYPASS_FILE" > "$tmp" 2>/dev/null || true
  mv "$tmp" "$DEVICE_BYPASS_FILE"
  chmod 600 "$DEVICE_BYPASS_FILE"
}

prerouting_chains() {
  nft list table "$NFT_FAMILY" "$NFT_TABLE" 2>/dev/null |
    awk '
      /^[[:space:]]*chain / { c=$2 }
      /hook prerouting/ { print c }
    ' |
    sort -u
}

ensure_device_bypass_nft() {
  local chains chain expiry mac ip host rest

  nft list table "$NFT_FAMILY" "$NFT_TABLE" >/dev/null 2>&1 || return 0

  if ! nft list set "$NFT_FAMILY" "$NFT_TABLE" "$NFT_DEVICE_BYPASS_SET" >/dev/null 2>&1; then
    nft add set "$NFT_FAMILY" "$NFT_TABLE" "$NFT_DEVICE_BYPASS_SET" \
      '{ type ipv4_addr; flags interval; }' 2>/dev/null || return 1
  fi

  chains="$(prerouting_chains)"
  [ -n "$chains" ] || return 1
  for chain in $chains; do
    if ! nft -a list chain "$NFT_FAMILY" "$NFT_TABLE" "$chain" 2>/dev/null | grep -q "ip saddr @$NFT_DEVICE_BYPASS_SET"; then
      nft insert rule "$NFT_FAMILY" "$NFT_TABLE" "$chain" ip saddr \
        "@$NFT_DEVICE_BYPASS_SET" counter accept 2>/dev/null || return 1
    fi
    nft -a list chain "$NFT_FAMILY" "$NFT_TABLE" "$chain" 2>/dev/null |
      grep -q "ip saddr @$NFT_DEVICE_BYPASS_SET" || return 1
  done

  nft flush set "$NFT_FAMILY" "$NFT_TABLE" "$NFT_DEVICE_BYPASS_SET" 2>/dev/null || return 1

  [ -f "$DHCP_LEASES_FILE" ] || return 0
  while read -r expiry mac ip host rest; do
    [ -n "${mac:-}" ] || continue
    is_ipv4 "$ip" || continue
    mac="$(normalize_mac "$mac")"
    device_mac_disabled "$mac" || continue
    nft add element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_DEVICE_BYPASS_SET" \
      "{ $ip }" 2>/dev/null || return 1
  done < "$DHCP_LEASES_FILE"
  nft list set "$NFT_FAMILY" "$NFT_TABLE" "$NFT_DEVICE_BYPASS_SET" >/dev/null 2>&1
}

device_bypass_ip_present() {
  local ip="$1"
  nft list set "$NFT_FAMILY" "$NFT_TABLE" "$NFT_DEVICE_BYPASS_SET" 2>/dev/null |
    grep -Eq "(^|[[:space:],{])$ip([[:space:],}]|$)"
}

flush_device_conntrack() {
  local ip="$1"
  command -v conntrack >/dev/null 2>&1 || return 0
  conntrack -D -s "$ip" 2>/dev/null || true
  conntrack -D -d "$ip" 2>/dev/null || true
}

set_device_bypass() {
  local mode="$1"
  local mac="$2"
  local ip="${3:-}"
  local backup="/tmp/vpn-ui-device-bypass.$$.preimage" was_absent=false failure=""

  valid_mac "$mac" || die_json "invalid MAC address: $mac"
  [ -z "$ip" ] || is_ipv4 "$ip" || die_json "invalid IPv4 address: $ip"
  mac="$(normalize_mac "$mac")"
  if [ -f "$DEVICE_BYPASS_FILE" ]; then
    cp -p "$DEVICE_BYPASS_FILE" "$backup" || die_json "could not preserve Device VPN pre-state"
  else
    was_absent=true
  fi

  case "$mode" in
    disable)
      append_disabled_mac "$mac" || failure="could not persist the Device VPN bypass"
      ;;
    enable)
      delete_disabled_mac "$mac" || failure="could not persist the Device VPN enable state"
      ;;
    *)
      die_json "device mode must be enable or disable"
      ;;
  esac

  [ -n "$failure" ] || ensure_device_bypass_nft ||
    failure="could not apply the Device VPN bypass set"
  if [ -z "$failure" ] && [ -n "$ip" ] && command -v nft >/dev/null 2>&1 &&
    nft list table "$NFT_FAMILY" "$NFT_TABLE" >/dev/null 2>&1; then
    case "$mode" in
      disable) device_bypass_ip_present "$ip" || failure="Device VPN bypass was not present after Apply" ;;
      enable) device_bypass_ip_present "$ip" && failure="Device VPN bypass remained after Enable" ;;
    esac
  fi
  if [ -n "$failure" ]; then
    if [ "$was_absent" = true ]; then rm -f "$DEVICE_BYPASS_FILE"
    else cp -p "$backup" "$DEVICE_BYPASS_FILE" || true; fi
    rm -f "$backup"
    if ensure_device_bypass_nft; then
      die_json "$failure; exact Device VPN pre-state restored"
    fi
    die_json "$failure; Device VPN rollback failed and recovery is required"
  fi
  rm -f "$backup"
  [ -n "$ip" ] && flush_device_conntrack "$ip"
}

start_xray_services() {
  local previous_gate previous_xray_enabled=false previous_xray_running=false
  local previous_transparent_enabled=false previous_transparent_running=false failure=""

  init_state
  [ -x "${ROOT_PREFIX}/etc/init.d/$XRAY_SERVICE" ] ||
    die_json "could not find the active Xray init script"
  [ -x "${ROOT_PREFIX}/etc/init.d/xray-transparent" ] ||
    die_json "the packaged transparent-proxy init script is missing"

  previous_gate="$(xray_gate_state)" || die_json "packaged Xray UCI enable state is invalid"
  service_enabled "$XRAY_SERVICE" && previous_xray_enabled=true
  service_running "$XRAY_SERVICE" && previous_xray_running=true
  service_enabled xray-transparent && previous_transparent_enabled=true
  transparent_running && previous_transparent_running=true

  if [ "$previous_gate" != not-applicable ]; then
    set_xray_gate_state 1 || failure="could not persist the packaged Xray enable gate"
  fi
  [ -n "$failure" ] || set_service_enabled_state "$XRAY_SERVICE" true ||
    failure="could not enable $XRAY_SERVICE for reboot persistence"
  [ -n "$failure" ] || set_service_enabled_state xray-transparent true ||
    failure="could not enable transparent proxying for reboot persistence"
  if [ -z "$failure" ] && ! service_running "$XRAY_SERVICE"; then
    "${ROOT_PREFIX}/etc/init.d/$XRAY_SERVICE" start >/tmp/vpn-ui-xray-start.log 2>&1 ||
      failure="could not start $XRAY_SERVICE: $(cat /tmp/vpn-ui-xray-start.log 2>/dev/null)"
  fi
  [ -n "$failure" ] || service_running "$XRAY_SERVICE" ||
    failure="$XRAY_SERVICE start returned without a running daemon"
  if [ -z "$failure" ] && ! transparent_running; then
    "${ROOT_PREFIX}/etc/init.d/xray-transparent" start >/tmp/vpn-ui-transparent-start.log 2>&1 ||
      failure="could not start xray-transparent: $(cat /tmp/vpn-ui-transparent-start.log 2>/dev/null)"
  fi
  [ -n "$failure" ] || transparent_running ||
    failure="xray-transparent start returned without complete transparent-proxy kernel state"
  [ -n "$failure" ] || ensure_device_bypass_nft ||
    failure="transparent proxying started but the Device VPN bypass state could not be applied"
  if [ -z "$failure" ] && [ "$previous_gate" != not-applicable ] &&
    [ "$(xray_gate_state)" != 1 ]; then
    failure="packaged Xray UCI enable state did not persist"
  fi
  [ -n "$failure" ] || service_enabled "$XRAY_SERVICE" ||
    failure="$XRAY_SERVICE is running but is not enabled for reboot"
  [ -n "$failure" ] || service_enabled xray-transparent ||
    failure="transparent proxying is active but is not enabled for reboot"

  if [ -n "$failure" ]; then
    if restore_xray_lifecycle_state "$previous_gate" "$previous_xray_enabled" \
      "$previous_xray_running" "$previous_transparent_enabled" \
      "$previous_transparent_running"; then
      die_json "$failure; exact UCI, daemon, transparent-proxy, and reboot pre-state restored"
    fi
    die_json "$failure; lifecycle rollback failed and recovery is required"
  fi
}

stop_xray_services() {
  local previous_gate previous_xray_enabled=false previous_xray_running=false
  local previous_transparent_enabled=false previous_transparent_running=false failure=""

  init_state
  [ -x "${ROOT_PREFIX}/etc/init.d/$XRAY_SERVICE" ] ||
    die_json "could not find the active Xray init script"
  [ -x "${ROOT_PREFIX}/etc/init.d/xray-transparent" ] ||
    die_json "the packaged transparent-proxy init script is missing"

  previous_gate="$(xray_gate_state)" || die_json "packaged Xray UCI enable state is invalid"
  service_enabled "$XRAY_SERVICE" && previous_xray_enabled=true
  service_running "$XRAY_SERVICE" && previous_xray_running=true
  service_enabled xray-transparent && previous_transparent_enabled=true
  transparent_running && previous_transparent_running=true

  if transparent_running; then
    "${ROOT_PREFIX}/etc/init.d/xray-transparent" stop >/tmp/vpn-ui-transparent-stop.log 2>&1 ||
      failure="could not stop xray-transparent: $(cat /tmp/vpn-ui-transparent-stop.log 2>/dev/null)"
  fi
  [ -n "$failure" ] || ! transparent_running ||
    failure="xray-transparent stop returned while transparent-proxy kernel state remained active"
  if [ -z "$failure" ] && service_running "$XRAY_SERVICE"; then
    "${ROOT_PREFIX}/etc/init.d/$XRAY_SERVICE" stop >/tmp/vpn-ui-xray-stop.log 2>&1 ||
      failure="could not stop $XRAY_SERVICE: $(cat /tmp/vpn-ui-xray-stop.log 2>/dev/null)"
  fi
  [ -n "$failure" ] || ! service_running "$XRAY_SERVICE" ||
    failure="$XRAY_SERVICE stop returned while the daemon remained running"
  [ -n "$failure" ] || set_service_enabled_state xray-transparent false ||
    failure="could not disable transparent proxying for reboot persistence"
  [ -n "$failure" ] || set_service_enabled_state "$XRAY_SERVICE" false ||
    failure="could not disable $XRAY_SERVICE for reboot persistence"
  if [ -z "$failure" ] && [ "$previous_gate" != not-applicable ]; then
    set_xray_gate_state 0 || failure="could not persist the packaged Xray disable gate"
  fi
  if [ -z "$failure" ] && [ "$previous_gate" != not-applicable ] &&
    [ "$(xray_gate_state)" != 0 ]; then
    failure="packaged Xray UCI disable state did not persist"
  fi

  if [ -n "$failure" ]; then
    if restore_xray_lifecycle_state "$previous_gate" "$previous_xray_enabled" \
      "$previous_xray_running" "$previous_transparent_enabled" \
      "$previous_transparent_running"; then
      die_json "$failure; exact UCI, daemon, transparent-proxy, and reboot pre-state restored"
    fi
    die_json "$failure; lifecycle rollback failed and recovery is required"
  fi
}

tcp_probe_ms() {
  local host="$1"
  local port="$2"
  local value

  value="$(curl -k -sS -o /dev/null \
    --connect-timeout 3 --max-time 4 \
    -w '%{time_connect}' "https://$host:$port/" 2>/dev/null || true)"
  awk -v value="$value" 'BEGIN {
    if (value + 0 <= 0) {
      print "timeout"
      exit
    }
    printf "%d ms\n", (value * 1000) + 0.5
  }'
}

active_proxy_probe_ms() {
  local value

  detect_xray_paths
  value="$(curl -k -4 -sS -o /dev/null \
    --connect-timeout 4 --max-time 8 \
    -x "socks5h://$LAN_IP:11808" \
    -w '%{time_starttransfer}' "https://api.ipify.org/" 2>/dev/null || true)"
  awk -v value="$value" 'BEGIN {
    if (value + 0 <= 0) {
      print "timeout"
      exit
    }
    printf "%d ms\n", (value * 1000) + 0.5
  }'
}

profile_ping_cached() {
  local id="$1"
  local file="$PING_DIR/$id"
  [ -f "$file" ] && cat "$file" || printf 'not tested'
}

refresh_profile_ping() {
  local id="$1"
  local host="$2"
  local port="$3"
  local selected probe
  mkdir -p "$PING_DIR"
  selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"
  if [ "$id" = "$selected" ]; then
    active_proxy_probe_ms > "$PING_DIR/$id"
    return
  fi
  probe="$(tcp_probe_ms "$host" "$port")"
  case "$probe" in
    timeout) printf '%s\n' "$probe" > "$PING_DIR/$id" ;;
    *) printf 'tcp %s\n' "$probe" > "$PING_DIR/$id" ;;
  esac
}

ping_numeric() {
  printf '%s' "$1" | sed -n 's/^\([0-9][0-9]*\) ms$/\1/p'
}

pool_has_id() {
  grep -qxF "$1" "$AUTO_POOL_FILE" 2>/dev/null
}

load_auto_config() {
  AUTO_FAILOVER="0"
  AUTO_PERIODIC="0"
  AUTO_PERIODIC_HOURS="12"
  AUTO_FAILURE_LIMIT="3"
  [ -f "$AUTO_CONFIG" ] && . "$AUTO_CONFIG"
}

auto_json() {
  local first id
  load_auto_config
  printf '{"failover":%s,"periodic":%s,"periodic_hours":%s,"failure_limit":%s,"pool":[' \
    "$([ "$AUTO_FAILOVER" = "1" ] && printf true || printf false)" \
    "$([ "$AUTO_PERIODIC" = "1" ] && printf true || printf false)" \
    "${AUTO_PERIODIC_HOURS:-12}" "${AUTO_FAILURE_LIMIT:-3}"
  first=1
  if [ -f "$AUTO_POOL_FILE" ]; then
    while IFS= read -r id || [ -n "$id" ]; do
      [ -n "$id" ] || continue
      if [ "$first" = "1" ]; then first=0; else printf ','; fi
      json_string "$id"
    done < "$AUTO_POOL_FILE"
  fi
  printf ']}'
}

tailscale_json() {
  local running ip prefs control hostname status_file version tailnet backend enabled pid first_pid start_id
  running="false"
  pid="$(tailscale_daemon_pids)"
  first_pid="${pid%% *}"
  start_id=""
  if [ -n "$first_pid" ]; then
    running=true
    start_id="$(overlay_process_start_id "$first_pid" 2>/dev/null || true)"
  fi
  enabled=false
  [ -x "${ROOT_PREFIX}/etc/init.d/tailscale" ] &&
    "${ROOT_PREFIX}/etc/init.d/tailscale" enabled >/dev/null 2>&1 && enabled=true
  ip=""
  prefs=""
  control=""
  hostname=""
  tailnet=""
  backend=""
  version="$(tailscale version 2>/dev/null | sed -n '1p')"
  status_file="/tmp/vpn-ui-tailscale-status.$$"
  : > "$status_file"
  if [ -n "$first_pid" ]; then
    ip="$(tailscale ip -4 2>/dev/null | sed -n '1p')"
    prefs="$(tailscale debug prefs 2>/dev/null || true)"
    control="$(printf '%s\n' "$prefs" | jsonfilter -e '@.ControlURL' 2>/dev/null || true)"
    hostname="$(printf '%s\n' "$prefs" | jsonfilter -e '@.Hostname' 2>/dev/null || true)"
    if tailscale status --json > "$status_file" 2>/dev/null; then
      tailnet="$(jsonfilter -i "$status_file" -e '@.CurrentTailnet.Name' 2>/dev/null || true)"
      backend="$(jsonfilter -i "$status_file" -e '@.BackendState' 2>/dev/null || true)"
    fi
  fi
  printf '{"running":%s,"boot_enabled":%s,"connected":%s,"pid":' \
    "$running" "$enabled" "$([ -n "$ip" ] && printf true || printf false)"
  json_string "$pid"
  printf ',"process_start_id":'
  json_string "$start_id"
  printf ',"backend_state":'
  json_string "$backend"
  printf ',"ip":'
  json_string "$ip"
  printf ',"control_url":'
  json_string "$control"
  printf ',"hostname":'
  json_string "$hostname"
  printf ',"version":'
  json_string "$version"
  printf ',"tailnet":'
  json_string "$tailnet"
  printf ',"peers":'
  tailscale_peers_json "$status_file"
  printf '}'
  rm -f "$status_file"
}

tailscale_peers_json() {
  local status_file="$1"
  local first peer hostname dns_name os ip online active exit_node
  local exit_option relay direct_address last_seen

  printf '['
  first=1
  jsonfilter -i "$status_file" -e '@.Peer.*' 2>/dev/null |
    while IFS= read -r peer || [ -n "$peer" ]; do
      [ -n "$peer" ] || continue
      hostname="$(printf '%s\n' "$peer" | jsonfilter -e '@.HostName' 2>/dev/null || true)"
      dns_name="$(printf '%s\n' "$peer" | jsonfilter -e '@.DNSName' 2>/dev/null || true)"
      os="$(printf '%s\n' "$peer" | jsonfilter -e '@.OS' 2>/dev/null || true)"
      ip="$(printf '%s\n' "$peer" | jsonfilter -e '@.TailscaleIPs[0]' 2>/dev/null || true)"
      online="$(printf '%s\n' "$peer" | jsonfilter -e '@.Online' 2>/dev/null || printf false)"
      active="$(printf '%s\n' "$peer" | jsonfilter -e '@.Active' 2>/dev/null || printf false)"
      exit_node="$(printf '%s\n' "$peer" | jsonfilter -e '@.ExitNode' 2>/dev/null || printf false)"
      exit_option="$(printf '%s\n' "$peer" | jsonfilter -e '@.ExitNodeOption' 2>/dev/null || printf false)"
      relay="$(printf '%s\n' "$peer" | jsonfilter -e '@.Relay' 2>/dev/null || true)"
      direct_address="$(printf '%s\n' "$peer" | jsonfilter -e '@.CurAddr' 2>/dev/null || true)"
      last_seen="$(printf '%s\n' "$peer" | jsonfilter -e '@.LastSeen' 2>/dev/null || true)"
      case "$last_seen" in 0001-01-01T*) last_seen="" ;; esac
      [ "$online" = "true" ] || online="false"
      [ "$active" = "true" ] || active="false"
      [ "$exit_node" = "true" ] || exit_node="false"
      [ "$exit_option" = "true" ] || exit_option="false"

      if [ "$first" = "1" ]; then first=0; else printf ','; fi
      printf '{"hostname":'
      json_string "$hostname"
      printf ',"dns_name":'
      json_string "$dns_name"
      printf ',"os":'
      json_string "$os"
      printf ',"ip":'
      json_string "$ip"
      printf ',"online":%s,"active":%s,"exit_node":%s,"exit_node_option":%s' \
        "$online" "$active" "$exit_node" "$exit_option"
      printf ',"relay":'
      json_string "$relay"
      printf ',"direct_address":'
      json_string "$direct_address"
      printf ',"last_seen":'
      json_string "$last_seen"
      printf '}'
    done
  printf ']'
}

tailscale_status_json() {
  printf '{"ok":true,"tailscale":'
  tailscale_json
  printf '}\n'
}

service_state() {
  local xray_state transparent_state vpn_enabled
  xray_state="stopped"
  transparent_state="inactive"
  vpn_enabled="false"
  service_running "$XRAY_SERVICE" && xray_state="running"
  transparent_running && transparent_state="active"
  [ "$xray_state" = "running" ] && [ "$transparent_state" = "active" ] && vpn_enabled="true"
  printf '"services":{"xray":'
  json_string "$xray_state"
  printf ',"transparent":'
  json_string "$transparent_state"
  printf ',"vpn_enabled":%s' "$vpn_enabled"
  printf '}'
}

normalize_domain_input() {
  local value="$1"

  value="$(printf '%s' "$value" | tr 'A-Z' 'a-z')"
  case "$value" in
    *://*) value="${value#*://}" ;;
  esac
  value="${value%%/*}"
  value="${value%%\?*}"
  value="${value%%#*}"
  value="${value##*@}"
  case "$value" in
    *:*) value="${value%%:*}" ;;
  esac
  value="${value%.}"
  printf '%s' "$value" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

valid_domain_name() {
  local domain="$1"

  [ ${#domain} -le 253 ] || return 1
  printf '%s' "$domain" | grep -Eq '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
}

dns_ips_json() {
  local domain="$1"
  local first ip

  first=1
  printf '['
  nslookup "$domain" 2>/dev/null |
    awk '
      /^Address [0-9]+: [0-9]/ { print $3 }
      /^Address: [0-9]/ { print $2 }
    ' |
    grep -E '^[0-9]+(\.[0-9]+){3}$' |
    awk '!seen[$0]++' |
    while IFS= read -r ip; do
      if [ "$first" = "1" ]; then
        first=0
      else
        printf ','
      fi
      json_string "$ip"
    done
  printf ']'
}

file_line_count() {
  local file="$1"
  [ -f "$file" ] || {
    printf '0'
    return
  }
  wc -l < "$file" | tr -d ' '
}

access_log_since() {
  local start="$1"
  local begin

  [ -f "$XRAY_ACCESS_LOG" ] || return 0
  begin=$((start + 1))
  sed -n "${begin},\$p" "$XRAY_ACCESS_LOG" 2>/dev/null
}

extract_outbound_tag() {
  sed -n 's/.*\[socks-in -> \([^]]*\)\].*/\1/p' | sed -n '1p'
}

run_domain_probe() {
  local domain="$1"
  local scheme="$2"
  local before metrics err rc line

  before="$(file_line_count "$XRAY_ACCESS_LOG")"
  err="/tmp/vpn-ui-domain-test-err.$$"
  metrics="$(curl -4 -k -sS --connect-timeout 5 --max-time 12 \
    -o /dev/null \
    -w 'http_code=%{http_code}\ntime_total=%{time_total}\n' \
    -x "socks5h://$LAN_IP:11808" \
    "$scheme://$domain/" 2>"$err")"
  rc=$?

  TEST_SCHEME="$scheme"
  TEST_CURL_EXIT="$rc"
  TEST_HTTP_CODE="$(printf '%s\n' "$metrics" | sed -n 's/^http_code=//p' | sed -n '1p')"
  TEST_TIME_TOTAL="$(printf '%s\n' "$metrics" | sed -n 's/^time_total=//p' | sed -n '1p')"
  TEST_CURL_ERROR="$(one_line "$(cat "$err" 2>/dev/null || true)")"
  rm -f "$err"

  line="$(access_log_since "$before" | grep -F "accepted tcp:$domain:" | grep -F '[socks-in ->' | tail -n 1)"
  [ -n "$line" ] || line="$(access_log_since "$before" | grep -F '[socks-in ->' | tail -n 1)"
  TEST_ACCESS_LINE="$line"
  TEST_OUTBOUND="$(printf '%s\n' "$line" | extract_outbound_tag)"
}

public_ip_probe() {
  local mode="$1"
  local url value

  for url in \
    https://api.ipify.org \
    https://ifconfig.me/ip \
    https://icanhazip.com \
    https://checkip.amazonaws.com
  do
    case "$mode" in
      proxy)
        value="$(curl -4 -k -sS --connect-timeout 4 --max-time 10 \
          -x "socks5h://$LAN_IP:11808" "$url" 2>/dev/null || true)"
        ;;
      *)
        value="$(curl -4 -k -sS --connect-timeout 4 --max-time 8 \
          "$url" 2>/dev/null || true)"
        ;;
    esac

    value="$(one_line "$value")"
    if is_ipv4 "$value"; then
      printf '%s' "$value"
      return
    fi
  done

  printf 'unavailable'
}

cmd_test_domain() {
  local raw="$1"
  local domain route selected direct_ip proxy_ip

  read_state
  ensure_domain_rule_data "$DOMAINS_FILE"

  domain="$(normalize_domain_input "$raw")"
  [ -n "$domain" ] || die_json "enter a domain to test"
  case "$domain" in
    geosite:*|regexp:*) die_json "enter a concrete domain, not a matcher" ;;
  esac
  valid_domain_name "$domain" || die_json "invalid domain: $domain"

  TEST_SCHEME=""
  TEST_CURL_EXIT=""
  TEST_HTTP_CODE=""
  TEST_TIME_TOTAL=""
  TEST_CURL_ERROR=""
  TEST_ACCESS_LINE=""
  TEST_OUTBOUND=""

  run_domain_probe "$domain" https
  if [ -z "$TEST_OUTBOUND" ] && [ "$TEST_CURL_EXIT" != "0" ]; then
    run_domain_probe "$domain" http
  fi

  route="unknown"
  case "$TEST_OUTBOUND" in
    direct) route="direct" ;;
    proxy) route="vpn" ;;
    "") route="unknown" ;;
    *) route="$TEST_OUTBOUND" ;;
  esac

  direct_ip="$(public_ip_probe direct)"
  proxy_ip="$(public_ip_probe proxy)"
  selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"
  if [ -n "$selected" ]; then
    load_profile_id "$selected"
  else
    reset_profile_vars
  fi

  printf '{"ok":true,"test":{"domain":'
  json_string "$domain"
  printf ',"route":'
  json_string "$route"
  printf ',"outbound":'
  json_string "${TEST_OUTBOUND:-unknown}"
  printf ',"scheme":'
  json_string "$TEST_SCHEME"
  printf ',"http_code":'
  json_string "$TEST_HTTP_CODE"
  printf ',"time_total":'
  json_string "$TEST_TIME_TOTAL"
  printf ',"curl_exit":'
  json_string "$TEST_CURL_EXIT"
  printf ',"curl_error":'
  json_string "$TEST_CURL_ERROR"
  printf ',"access_log":'
  json_string "$TEST_ACCESS_LINE"
  printf ',"resolved_ips":'
  dns_ips_json "$domain"
  printf ',"public_ips":{"direct":'
  json_string "$direct_ip"
  printf ',"vpn":'
  json_string "$proxy_ip"
  printf '},"profile":{"id":'
  json_string "$selected"
  printf ',"name":'
  json_string "$P_NAME"
  printf ',"endpoint":'
  json_string "$P_HOST:$P_PORT"
  printf ',"vps_ip":'
  json_string "$P_VPS_IP"
  printf '},'
  service_state
  printf '}}\n'
}

json_array_from_file() {
  local file="$1"
  local first item

  first=1
  printf '['
  [ -f "$file" ] || {
    printf ']'
    return 0
  }
  awk '
    {
      sub(/\r$/, "")
      sub(/^[ \t]+/, "")
      sub(/[ \t]+$/, "")
      if ($0 == "" || $0 ~ /^#/) next
      if (!seen[$0]++) print
    }
  ' "$file" | while IFS= read -r item; do
    if [ "$first" = "1" ]; then
      first=0
    else
      printf ','
    fi
    json_string "$item"
  done
  printf ']'
}

dhcp_devices_json() {
  local now first expiry mac ip host rest disabled remaining label

  now="$(date +%s)"
  first=1
  printf '['
  [ -f "$DHCP_LEASES_FILE" ] || {
    printf ']'
    return 0
  }

  while read -r expiry mac ip host rest; do
    [ -n "${mac:-}" ] || continue
    is_ipv4 "$ip" || continue
    valid_mac "$mac" || continue

    mac="$(normalize_mac "$mac")"
    label="$host"
    [ -n "$label" ] || label="-"
    [ "$label" = "*" ] && label="-"

    if [ "${expiry:-0}" = "0" ]; then
      remaining="static"
    else
      remaining="$(format_duration $((expiry - now)))"
    fi

    disabled="false"
    device_mac_disabled "$mac" && disabled="true"

    if [ "$first" = "1" ]; then
      first=0
    else
      printf ','
    fi

    printf '{"hostname":'
    json_string "$label"
    printf ',"ip":'
    json_string "$ip"
    printf ',"mac":'
    json_string "$mac"
    printf ',"lease_remaining":'
    json_string "$remaining"
    printf ',"vpn_disabled":%s}' "$disabled"
  done < "$DHCP_LEASES_FILE"

  printf ']'
}

ownership_status_json() {
  local actual_hash="" config_matches=false discovery_matches=false healthy=false
  local capability_matches=false selectors_match=false adoption_required=false active_path="" error="" domain_count ip_count
  local inspect_file domain_index ip_index

  update_mutation_status || true
  if adoption_state_load; then
    if safe_adopted_config_file "$OWNERSHIP_PATH"; then
      actual_hash="$(config_sha256 "$OWNERSHIP_PATH")"
      [ "$actual_hash" = "$OWNERSHIP_CONFIG_HASH" ] && config_matches=true
    else
      error="adopted configuration path is unsafe, missing, or symlinked"
    fi
    if discover_active_xray_config; then
      active_path="$ACTIVE_XRAY_CONFIG"
      [ "$active_path" = "$OWNERSHIP_PATH" ] && discovery_matches=true
    else
      [ -n "$error" ] || error="$ACTIVE_XRAY_DISCOVERY_ERROR"
    fi
    if [ "$config_matches" = true ]; then
      inspect_file="/tmp/vpn-ui-ownership-capability.$$.json"
      if overlay_exec inspect "$(host_path "$OWNERSHIP_PATH")" >"$inspect_file" 2>&1; then
        capability_matches=true
        domain_index="$(json_value "$inspect_file" '@.domain_rule_index' '.domain_rule_index')"
        ip_index="$(json_value "$inspect_file" '@.ip_rule_index' '.ip_rule_index')"
        [ "$domain_index" = "$OWNERSHIP_DOMAIN_INDEX" ] &&
          [ "$ip_index" = "$OWNERSHIP_IP_INDEX" ] && selectors_match=true
        [ "$selectors_match" = true ] || error="adopted Xray selectors no longer identify the supported structure"
      else
        error="$(json_value "$inspect_file" '@.error' '.error')"
        [ -n "$error" ] || error="unsupported adopted Xray structure or capability"
      fi
      rm -f "$inspect_file"
    fi
    [ "$config_matches" = true ] && [ "$discovery_matches" = true ] &&
      [ "$capability_matches" = true ] && [ "$selectors_match" = true ] && healthy=true
    domain_count="$(awk 'NF && $0 !~ /^[[:space:]]*#/ {count++} END {print count+0}' "$(managed_state_path "$DOMAINS_FILE")" 2>/dev/null)"
    ip_count="$(awk 'NF && $0 !~ /^[[:space:]]*#/ {count++} END {print count+0}' "$(managed_state_path "$IPS_FILE")" 2>/dev/null)"
    printf '{"mode":"adopted-overlay","adopted":true,"adoption_required":false,"healthy":%s' "$healthy"
    printf ',"path":'
    json_string "$OWNERSHIP_PATH"
    printf ',"active_path":'
    json_string "$active_path"
    printf ',"config_sha256":'
    json_string "$OWNERSHIP_CONFIG_HASH"
    printf ',"config_matches":%s,"discovery_matches":%s' "$config_matches" "$discovery_matches"
    printf ',"capability_matches":%s,"selectors_match":%s' "$capability_matches" "$selectors_match"
    printf ',"domain_count":%s,"ip_count":%s,"error":' "${domain_count:-0}" "${ip_count:-0}"
    json_string "$error"
    printf ',"mutations_allowed":%s,"mutation_block_reason":' "$UPDATE_MUTATIONS_ALLOWED"
    json_string "$UPDATE_MUTATION_BLOCK_REASON"
    printf '}'
    return 0
  fi

  if discover_active_xray_config; then
    active_path="$ACTIVE_XRAY_CONFIG"
    [ "$active_path" = "$NATIVE_XRAY_CONFIG" ] || adoption_required=true
  else
    adoption_required=true
    error="$ACTIVE_XRAY_DISCOVERY_ERROR"
  fi
  [ "$adoption_required" = false ] && healthy=true
  printf '{"mode":"native-generated","adopted":false,"adoption_required":%s,"healthy":%s' \
    "$adoption_required" "$healthy"
  printf ',"path":'
  json_string "$NATIVE_XRAY_CONFIG"
  printf ',"active_path":'
  json_string "$active_path"
  printf ',"error":'
  json_string "$error"
  printf ',"mutations_allowed":%s,"mutation_block_reason":' "$UPDATE_MUTATIONS_ALLOWED"
  json_string "$UPDATE_MUTATION_BLOCK_REASON"
  printf '}'
}

status_json() {
  local selected first f id active ping protocol in_pool

  read_state
  selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"

  printf '{"ok":true,'
  printf '"selected":'
  json_string "$selected"
  printf ',"profiles":['
  first=1
  for f in "$PROFILE_DIR"/*.conf; do
    [ -f "$f" ] || continue
    load_profile_file "$f"
    id="$(basename "$f" .conf)"
    active="false"
    [ "$id" = "$selected" ] && active="true"
    ping="$(profile_ping_cached "$id")"
    protocol="vless $P_NETWORK $P_SECURITY"
    in_pool="false"
    pool_has_id "$id" && in_pool="true"
    if [ "$first" = "1" ]; then
      first=0
    else
      printf ','
    fi
    printf '{"id":'
    json_string "$id"
    printf ',"name":'
    json_string "$P_NAME"
    printf ',"host":'
    json_string "$P_HOST"
    printf ',"port":'
    json_string "$P_PORT"
    printf ',"vps_ip":'
    json_string "$P_VPS_IP"
    printf ',"protocol":'
    json_string "$protocol"
    printf ',"ping":'
    json_string "$ping"
    printf ',"source_id":'
    json_string "$P_SOURCE_ID"
    printf ',"auto_pool":%s' "$in_pool"
    printf ',"selected":%s}' "$active"
  done
  printf '],"subscriptions":'
  subscription_json
  printf ',"auto":'
  auto_json
  printf ',"ownership":'
  ownership_status_json
  printf ',"domains":'
  json_array_from_file "$DOMAINS_FILE"
  printf ',"ips":'
  json_array_from_file "$IPS_FILE"
  printf ',"devices":'
  dhcp_devices_json
  printf ',"router_metadata":{'
  router_metadata_json_members
  printf '}'
  printf ','
  service_state
  printf '}\n'
}

vpn_summary_json() {
  local selected file domain_count ping xray_state transparent_state vpn_enabled

  read_state
  selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"
  file="$PROFILE_DIR/$selected.conf"
  xray_state="stopped"
  transparent_state="inactive"
  vpn_enabled="false"
  service_running "$XRAY_SERVICE" && xray_state="running"
  transparent_running && transparent_state="active"
  [ "$xray_state" = "running" ] && [ "$transparent_state" = "active" ] && vpn_enabled="true"

  if [ -z "$selected" ] || [ ! -f "$file" ]; then
    printf '{"ok":true,"configured":false,"working":%s,"xray":' "$vpn_enabled"
    json_string "$xray_state"
    printf ',"transparent":'
    json_string "$transparent_state"
    printf ',"selected_id":"","selected_name":"","endpoint":"","ip":"","direct_domain_rules":0,"ping":"not tested"}\n'
    return 0
  fi

  load_profile_file "$file"
  domain_count="$(awk '
    {
      sub(/\r$/, "")
      sub(/^[[:space:]]+/, "")
      sub(/[[:space:]]+$/, "")
    }
    NF && $0 !~ /^#/ { count++ }
    END { print count + 0 }
  ' "$DOMAINS_FILE" 2>/dev/null)"
  ping="$(profile_ping_cached "$selected")"

  printf '{"ok":true,"configured":true,"working":%s,"xray":' "$vpn_enabled"
  json_string "$xray_state"
  printf ',"transparent":'
  json_string "$transparent_state"
  printf ',"selected_id":'
  json_string "$selected"
  printf ',"selected_name":'
  json_string "$P_NAME"
  printf ',"endpoint":'
  json_string "$P_HOST:$P_PORT"
  printf ',"ip":'
  json_string "$P_VPS_IP"
  printf ',"direct_domain_rules":%s,"ping":' "${domain_count:-0}"
  json_string "$ping"
  printf '}\n'
}

cmd_add() {
  local url="$1"
  require_managed_ownership
  init_state
  parse_vless_url "$url"
  write_profile_file
  status_json
}

cmd_select() {
  local id="$1"
  require_update_committed_for_mutation
  if adoption_state_load; then
    apply_adopted_rules "$DOMAINS_FILE" "$IPS_FILE" "$id"
  else
    require_native_ownership_readonly
    render_and_apply "$id" "$DOMAINS_FILE" "$IPS_FILE" "0"
  fi
  status_json
}

cmd_delete() {
  local id="$1"
  local selected
  require_managed_ownership
  init_state
  selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"
  [ "$id" != "$selected" ] || die_json "refusing to delete the selected profile"
  [ -f "$PROFILE_DIR/$id.conf" ] || die_json "unknown VLESS profile: $id"
  rm -f "$PROFILE_DIR/$id.conf"
  status_json
}

cmd_apply_rules() {
  local selected domains_text ips_text tmp_domains tmp_ips

  domains_text="${1:-}"
  ips_text="${2:-}"
  tmp_domains="/tmp/vpn-ui-domains.$$"
  tmp_ips="/tmp/vpn-ui-ips.$$"
  normalize_text_to_file "$domains_text" "$tmp_domains"
  normalize_text_to_file "$ips_text" "$tmp_ips"
  if adoption_state_load; then
    apply_adopted_rules "$tmp_domains" "$tmp_ips"
  else
    require_native_ownership
    init_state
    selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"
    [ -n "$selected" ] || {
      rm -f "$tmp_domains" "$tmp_ips"
      die_json "no selected VLESS profile"
    }
    render_and_apply "$selected" "$tmp_domains" "$tmp_ips" "1"
  fi
  rm -f "$tmp_domains" "$tmp_ips"
  status_json
}

cmd_check() {
  local selected tmpcfg test_out

  if adoption_state_load; then
    discover_active_xray_config || die_json "$ACTIVE_XRAY_DISCOVERY_ERROR"
    [ "$ACTIVE_XRAY_CONFIG" = "$OWNERSHIP_PATH" ] ||
      die_json "active Xray configuration path drifted from the adopted path"
    [ "$(config_sha256 "$OWNERSHIP_PATH")" = "$OWNERSHIP_CONFIG_HASH" ] ||
      die_json "adopted Xray configuration bytes changed outside Router UI"
    adopted_xray_test "$(host_path "$OWNERSHIP_PATH")" ||
      die_json "Xray validation failed: $(one_line "$(cat "/tmp/vpn-ui-adopted-xray-test.$$" 2>/dev/null)")"
    printf '{"ok":true,"configured":true,"mode":"adopted-overlay","message":"active adopted configuration validates"}\n'
    return 0
  fi
  require_native_ownership_readonly
  read_state
  selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"
  [ -n "$selected" ] || {
    printf '{"ok":true,"configured":false,"message":"no selected VLESS profile; configuration is not enabled"}\n'
    return 0
  }
  load_profile_id "$selected"
  tmpcfg="/tmp/vpn-ui-check.$$.json"
  ensure_domain_rule_data "$DOMAINS_FILE"
  render_xray_config "$tmpcfg" "$DOMAINS_FILE" "$IPS_FILE"
  if ! xray_test "$tmpcfg"; then
    test_out="$(cat /tmp/vpn-ui-xray-test.log 2>/dev/null || true)"
    rm -f "$tmpcfg"
    die_json "Xray validation failed: $(one_line "$test_out")"
  fi
  rm -f "$tmpcfg"
  printf '{"ok":true,"configured":true,"message":"configuration validates"}\n'
}

cmd_device() {
  local mode="$1"
  local mac="$2"
  local ip="${3:-}"

  require_managed_ownership
  init_state
  set_device_bypass "$mode" "$mac" "$ip"
  status_json
}

cmd_xray() {
  local mode="$1"

  require_managed_ownership
  case "$mode" in
    on|enable|enabled)
      start_xray_services
      ;;
    off|disable|disabled)
      stop_xray_services
      ;;
    *)
      die_json "xray mode must be on or off"
      ;;
  esac
  status_json
}

cmd_refresh_pings() {
  local f id running
  require_managed_ownership
  init_state
  running=0
  for f in "$PROFILE_DIR"/*.conf; do
    [ -f "$f" ] || continue
    load_profile_file "$f"
    id="$(basename "$f" .conf)"
    rm -f "$PING_DIR/$id"
    refresh_profile_ping "$id" "$P_HOST" "$P_PORT" &
    running=$((running + 1))
    if [ "$running" -ge 6 ]; then
      wait
      running=0
    fi
  done
  wait
  for f in "$PROFILE_DIR"/*.conf; do
    [ -f "$f" ] || continue
    id="$(basename "$f" .conf)"
    [ -s "$PING_DIR/$id" ] &&
      grep -Eq '^(timeout|[0-9]+ ms|tcp [0-9]+ ms)$' "$PING_DIR/$id" ||
      die_json "reachability refresh did not produce a fresh result for every profile"
  done
  status_json
}

cmd_subscription_add() {
  local url="$1"
  local id name
  require_managed_ownership
  init_state
  url="$(trim_input "$url")"
  case "$url" in https://*) ;; *) die_json "subscription URL must use https://" ;; esac
  id="$(subscription_id_from_url "$url")"
  name="$(subscription_name_from_url "$url")"
  sync_subscription "$id" "$name" "$url"
  status_json
}

cmd_subscription_sync() {
  local id="$1"
  local file="$SUBSCRIPTION_DIR/$id.conf"
  require_managed_ownership
  init_state
  [ -f "$file" ] || die_json "unknown subscription"
  load_subscription_file "$file"
  sync_subscription "$S_ID" "$S_NAME" "$S_URL"
  status_json
}

cmd_subscription_delete() {
  local id="$1"
  local file="$SUBSCRIPTION_DIR/$id.conf"
  local selected f profile_id
  require_managed_ownership
  init_state
  [ -f "$file" ] || die_json "unknown subscription"
  selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"
  for f in "$PROFILE_DIR"/*.conf; do
    [ -f "$f" ] || continue
    load_profile_file "$f"
    [ "$P_SOURCE_ID" = "$id" ] || continue
    profile_id="$(basename "$f" .conf)"
    [ "$profile_id" = "$selected" ] && continue
    rm -f "$f"
    sed -i "\|^$profile_id\$|d" "$AUTO_POOL_FILE" 2>/dev/null || true
  done
  rm -f "$file"
  status_json
}

cmd_validate_vless() {
  parse_vless_url "$1"
  printf '{"ok":true,"profile":{"id":'
  json_string "$P_ID"
  printf ',"name":'
  json_string "$P_NAME"
  printf ',"host":'
  json_string "$P_HOST"
  printf ',"port":'
  json_string "$P_PORT"
  printf '}}\n'
}

cmd_subscription_preview() {
  local url="$1"
  local links="/tmp/vpn-ui-sub-preview.$$"
  local line count
  fetch_subscription_links "$url" "$links"
  count=0
  while IFS= read -r line || [ -n "$line" ]; do
    line="$(trim_input "$line")"
    case "$line" in vless://*|vless%3A*|vless%3a*) ;; *) continue ;; esac
    sh "$0" validate-vless "$line" 2>/dev/null | grep -q '"ok":true' || continue
    parse_vless_url "$line"
    count=$((count + 1))
  done < "$links"
  rm -f "$links"
  [ "$count" -gt 0 ] || die_json "subscription contained no usable VLESS profiles"
  printf '{"ok":true,"count":%s}\n' "$count"
}

cmd_auto_config() {
  local failover="$1"
  local periodic="$2"
  local hours="$3"
  local pool_text="$4"
  local tmp="/tmp/vpn-ui-auto-pool.$$" config_tmp="$AUTO_CONFIG.new.$$"
  local id expected_pool_hash

  require_managed_ownership
  init_state
  case "$failover" in 0|1) ;; *) die_json "invalid failover setting" ;; esac
  case "$periodic" in 0|1) ;; *) die_json "invalid periodic setting" ;; esac
  printf '%s' "$hours" | grep -Eq '^[0-9]+$' || die_json "periodic interval must be a number"
  [ "$hours" -ge 6 ] && [ "$hours" -le 168 ] || die_json "periodic interval must be between 6 and 168 hours"

  printf '%s\n' "$pool_text" | awk 'NF && !seen[$0]++ { print }' > "$tmp"
  while IFS= read -r id || [ -n "$id" ]; do
    [ -f "$PROFILE_DIR/$id.conf" ] || {
      rm -f "$tmp"
      die_json "auto-switch pool contains an unknown profile"
    }
  done < "$tmp"
  if [ "$failover" = "1" ] || [ "$periodic" = "1" ]; then
    [ -s "$tmp" ] || {
      rm -f "$tmp"
      die_json "select at least one profile for the auto-switch pool"
    }
  fi

  expected_pool_hash="$(sha256sum "$tmp" | awk '{print $1}')"
  cat > "$config_tmp" <<EOF
AUTO_FAILOVER='$failover'
AUTO_PERIODIC='$periodic'
AUTO_PERIODIC_HOURS='$hours'
AUTO_FAILURE_LIMIT='3'
EOF
  chmod 600 "$config_tmp" || die_json "automatic-switch configuration commit failed"
  mv "$config_tmp" "$AUTO_CONFIG" || die_json "automatic-switch configuration commit failed"
  mv "$tmp" "$AUTO_POOL_FILE" || die_json "automatic-switch pool commit failed"
  chmod 600 "$AUTO_CONFIG" "$AUTO_POOL_FILE" || die_json "automatic-switch file permissions failed"
  load_auto_config
  [ "$AUTO_FAILOVER" = "$failover" ] && [ "$AUTO_PERIODIC" = "$periodic" ] &&
    [ "$AUTO_PERIODIC_HOURS" = "$hours" ] &&
    [ "$(sha256sum "$AUTO_POOL_FILE" | awk '{print $1}')" = "$expected_pool_hash" ] ||
    die_json "automatic-switch configuration postcondition failed"
  status_json
}

best_pool_profile() {
  local exclude="${1:-}"
  local id f probe numeric best_id="" best_ms=""
  while IFS= read -r id || [ -n "$id" ]; do
    [ -n "$id" ] || continue
    [ "$id" = "$exclude" ] && continue
    f="$PROFILE_DIR/$id.conf"
    [ -f "$f" ] || continue
    load_profile_file "$f"
    probe="$(tcp_probe_ms "$P_HOST" "$P_PORT")"
    printf '%s\n' "$probe" > "$PING_DIR/$id"
    numeric="$(ping_numeric "$probe")"
    [ -n "$numeric" ] || continue
    if [ -z "$best_ms" ] || [ "$numeric" -lt "$best_ms" ]; then
      best_id="$id"
      best_ms="$numeric"
    fi
  done < "$AUTO_POOL_FILE"
  printf '%s %s\n' "$best_id" "$best_ms"
}

cmd_auto_tick() {
  local selected selected_file probe current_ms now fail_count last_optimize
  local best_id best_ms due threshold

  update_mutation_status || exit 0
  [ "$UPDATE_MUTATIONS_ALLOWED" = true ] || exit 0
  if adoption_state_load; then
    require_adopted_ownership
  elif ! discover_active_xray_config || [ "$ACTIVE_XRAY_CONFIG" != "$NATIVE_XRAY_CONFIG" ]; then
    exit 0
  fi
  init_state
  runtime_memory_maintenance
  load_auto_config
  [ "$AUTO_FAILOVER" = "1" ] || [ "$AUTO_PERIODIC" = "1" ] || exit 0
  selected="$(cat "$SELECTED_FILE" 2>/dev/null || true)"
  [ -n "$selected" ] || exit 0
  selected_file="$PROFILE_DIR/$selected.conf"
  [ -f "$selected_file" ] || exit 0

  FAIL_COUNT=0
  LAST_OPTIMIZE=0
  [ -f "$AUTO_STATE" ] && . "$AUTO_STATE"
  fail_count="${FAIL_COUNT:-0}"
  last_optimize="${LAST_OPTIMIZE:-0}"
  now="$(date +%s)"

  load_profile_file "$selected_file"
  probe="$(tcp_probe_ms "$P_HOST" "$P_PORT")"
  printf '%s\n' "$probe" > "$PING_DIR/$selected"
  current_ms="$(ping_numeric "$probe")"

  if [ "$AUTO_FAILOVER" = "1" ]; then
    if [ -z "$current_ms" ]; then
      fail_count=$((fail_count + 1))
      if [ "$fail_count" -ge "${AUTO_FAILURE_LIMIT:-3}" ]; then
        read -r best_id best_ms <<EOF
$(best_pool_profile "$selected")
EOF
        if [ -n "$best_id" ]; then
          if adoption_state_load; then
            apply_adopted_rules "$DOMAINS_FILE" "$IPS_FILE" "$best_id" || return 1
          else
            render_and_apply "$best_id" "$DOMAINS_FILE" "$IPS_FILE" "0" || return 1
          fi
          selected="$best_id"
          current_ms="$best_ms"
        fi
        fail_count=0
      fi
    else
      fail_count=0
    fi
  fi

  due=$((last_optimize + AUTO_PERIODIC_HOURS * 3600))
  if [ "$AUTO_PERIODIC" = "1" ] && [ "$now" -ge "$due" ] && [ -n "$current_ms" ]; then
    read -r best_id best_ms <<EOF
$(best_pool_profile "$selected")
EOF
    if [ -n "$best_id" ] && [ -n "$best_ms" ]; then
      threshold=$((current_ms * 65 / 100))
      if [ "$best_ms" -le "$threshold" ] && [ $((current_ms - best_ms)) -ge 30 ]; then
        if adoption_state_load; then
          apply_adopted_rules "$DOMAINS_FILE" "$IPS_FILE" "$best_id" || return 1
        else
          render_and_apply "$best_id" "$DOMAINS_FILE" "$IPS_FILE" "0" || return 1
        fi
      fi
    fi
    last_optimize="$now"
  fi

  cat > "$AUTO_STATE" <<EOF
FAIL_COUNT='$fail_count'
LAST_OPTIMIZE='$last_optimize'
EOF
}

cmd_tailscale_up() {
  local login_server="$1"
  local hostname="$2"
  local auth_key="$3"
  local advertise_routes="$4"
  local advertise_exit="$5"
  local log="/tmp/vpn-ui-tailscale-up.$$" transaction before after
  transaction="${ROOT_PREFIX}/tmp/vpn-ui-tailscale-action.$$"
  before="$transaction/before.txt"
  after="$transaction/after.txt"

  case "$login_server" in https://*) ;; *) die_json "Tailscale login server must use https://" ;; esac
  [ -n "$hostname" ] || hostname="$(uci -q get system.@system[0].hostname 2>/dev/null || printf openwrt)"
  tailscale_action_begin "$before" "$transaction" || die_json "could not capture the pre-action Tailscale state"
  "${ROOT_PREFIX}/etc/init.d/tailscale" enable >/tmp/vpn-ui-tailscale-service.log 2>&1 ||
    tailscale_action_failed "Tailscale settings apply" "$before" "$transaction" "boot enable failed"
  "${ROOT_PREFIX}/etc/init.d/tailscale" restart >/tmp/vpn-ui-tailscale-service.log 2>&1 ||
    "${ROOT_PREFIX}/etc/init.d/tailscale" start >/tmp/vpn-ui-tailscale-service.log 2>&1 ||
    tailscale_action_failed "Tailscale settings apply" "$before" "$transaction" "could not start tailscaled"

  set -- \
    "--login-server=$login_server" \
    "--hostname=$hostname" \
    "--accept-dns=false" \
    "--netfilter-mode=off"
  [ -n "$auth_key" ] && set -- "$@" "--auth-key=$auth_key"
  [ -n "$advertise_routes" ] && set -- "$@" "--advertise-routes=$advertise_routes"
  [ "$advertise_exit" = "1" ] && set -- "$@" "--advertise-exit-node"
  if ! tailscale up "$@" >"$log" 2>&1; then
    tailscale up --reset "$@" >"$log" 2>&1 || {
      rm -f "$log"
      tailscale_action_failed "Tailscale settings apply" "$before" "$transaction" \
        "tailscale up failed; verify the login server, TLS, and preauth key"
    }
  fi
  rm -f "$log"
  tailscale_registration_ready ||
    tailscale_action_failed "Tailscale settings apply" "$before" "$transaction" \
      "tailscale did not reach a registered Running state"
  tailscale_wait_invariants "$before" "$after" management "${VPN_UI_TAILSCALE_ACTION_TIMEOUT:-30}" ||
    tailscale_action_failed "Tailscale settings apply" "$before" "$transaction" \
      "management-route invariants changed"
  rm -rf "$transaction"
  tailscale_status_json
}

tailscale_registration_ready() {
  tailscale_wait_state true true Running nonempty "${VPN_UI_TAILSCALE_ACTION_TIMEOUT:-30}"
}

cmd_tailscale_logout() {
  local transaction before after enabled running
  transaction="${ROOT_PREFIX}/tmp/vpn-ui-tailscale-action.$$"
  before="$transaction/before.txt"
  after="$transaction/after.txt"
  tailscale_action_begin "$before" "$transaction" || die_json "could not capture the pre-action Tailscale state"
  enabled="$(tailscale_snapshot_value "$before" enabled)"
  [ -n "$(tailscale_snapshot_value "$before" pid)" ] && running=true || running=false
  tailscale logout >/tmp/vpn-ui-tailscale-logout.log 2>&1 ||
    tailscale_action_failed "Tailscale logout" "$before" "$transaction" "tailscale logout failed"
  tailscale_wait_state "$running" "$enabled" NeedsLogin empty \
    "${VPN_UI_TAILSCALE_ACTION_TIMEOUT:-30}" ||
    tailscale_action_failed "Tailscale logout" "$before" "$transaction" \
      "logout state did not converge before timeout"
  tailscale_wait_invariants "$before" "$after" management "${VPN_UI_TAILSCALE_ACTION_TIMEOUT:-30}" ||
    tailscale_action_failed "Tailscale logout" "$before" "$transaction" \
      "management-route invariants changed"
  rm -rf "$transaction"
  tailscale_status_json
}

cmd_tailscale_restart() {
  local transaction before after enabled backend expected_backend ip old_pid old_start require_new=false key
  transaction="${ROOT_PREFIX}/tmp/vpn-ui-tailscale-action.$$"
  before="$transaction/before.txt"
  after="$transaction/after.txt"
  tailscale_action_begin "$before" "$transaction" || die_json "could not capture the pre-action Tailscale state"
  enabled="$(tailscale_snapshot_value "$before" enabled)"
  backend="$(tailscale_snapshot_value "$before" backend)"
  ip="$(tailscale_snapshot_value "$before" ip4)"
  old_pid="$(tailscale_snapshot_value "$before" pid)"
  old_start="$(tailscale_snapshot_value "$before" process_start_id)"
  [ -n "$old_pid" ] && require_new=true
  expected_backend="$backend"
  tailscale_backend_stable "$expected_backend" || expected_backend=any-stable
  "${ROOT_PREFIX}/etc/init.d/tailscale" restart >/tmp/vpn-ui-tailscale-restart.log 2>&1 ||
    tailscale_action_failed "Tailscale restart" "$before" "$transaction" "init restart failed"
  tailscale_wait_state true "$enabled" "$expected_backend" "$ip" \
    "${VPN_UI_TAILSCALE_ACTION_TIMEOUT:-30}" "$old_pid" "$old_start" "$require_new" ||
    tailscale_action_failed "Tailscale restart" "$before" "$transaction" \
      "new healthy process state did not converge before timeout"
  tailscale_wait_invariants "$before" "$after" restart "${VPN_UI_TAILSCALE_ACTION_TIMEOUT:-30}" ||
    tailscale_action_failed "Tailscale restart" "$before" "$transaction" \
      "registered identity or routing invariant changed"
  rm -rf "$transaction"
  tailscale_status_json
}

cmd_tailscale_stop() {
  local transaction before after
  transaction="${ROOT_PREFIX}/tmp/vpn-ui-tailscale-action.$$"
  before="$transaction/before.txt"
  after="$transaction/after.txt"
  tailscale_action_begin "$before" "$transaction" || die_json "could not capture the pre-action Tailscale state"
  "${ROOT_PREFIX}/etc/init.d/tailscale" stop >/tmp/vpn-ui-tailscale-stop.log 2>&1 ||
    tailscale_action_failed "Tailscale stop" "$before" "$transaction" "init stop failed"
  "${ROOT_PREFIX}/etc/init.d/tailscale" disable >/tmp/vpn-ui-tailscale-stop.log 2>&1 ||
    tailscale_action_failed "Tailscale stop" "$before" "$transaction" "boot disable failed"
  tailscale_wait_state false false '' '' "${VPN_UI_TAILSCALE_ACTION_TIMEOUT:-30}" ||
    tailscale_action_failed "Tailscale stop" "$before" "$transaction" \
      "stopped and disabled state did not converge before timeout"
  tailscale_wait_invariants "$before" "$after" management "${VPN_UI_TAILSCALE_ACTION_TIMEOUT:-30}" ||
    tailscale_action_failed "Tailscale stop" "$before" "$transaction" \
      "management-route invariants changed"
  rm -rf "$transaction"
  tailscale_status_json
}

cmd_tailscale_ping() {
  local target="$1"
  local status_file="/tmp/vpn-ui-tailscale-ping-status.$$"
  local output reachable latency route

  printf '%s' "$target" | grep -Eq '^100\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' ||
    die_json "invalid Tailscale IPv4 address"
  tailscale status --json > "$status_file" 2>/dev/null ||
    die_json "could not read Tailscale peer state"
  jsonfilter -i "$status_file" -e '@.Peer.*.TailscaleIPs[0]' 2>/dev/null |
    grep -qxF "$target" || {
      rm -f "$status_file"
      die_json "target is not a visible Tailscale peer"
    }
  rm -f "$status_file"

  output="$(tailscale ping -c 3 --timeout=5s "$target" 2>&1 || true)"
  reachable="false"
  printf '%s\n' "$output" | grep -q '^pong from ' && reachable="true"
  latency="$(printf '%s\n' "$output" | sed -n 's/^pong from .* in \([0-9][0-9]*ms\)$/\1/p' | tail -n 1)"
  route="$(printf '%s\n' "$output" | sed -n 's/^pong from .* via \(.*\) in [0-9][0-9]*ms$/\1/p' | tail -n 1)"
  printf '{"ok":true,"target":'
  json_string "$target"
  printf ',"reachable":%s,"latency":' "$reachable"
  json_string "$latency"
  printf ',"route":'
  json_string "$route"
  printf ',"output":'
  json_string "$output"
  printf '}\n'
}

cmd_update() {
  local action="$1"
  shift
  [ -x /usr/sbin/vpn-ui-update ] || die_json "panel updater is not installed"
  /usr/sbin/vpn-ui-update "$action" "$@"
}

cmd_overlay_recover() {
  require_update_committed_for_mutation
  overlay_lock_acquire || die_json "another adopted-overlay transaction is active"
  overlay_recover_transactions || die_json "adopted-overlay recovery requires physical or LAN intervention"
  overlay_cleanup_transactions || true
  overlay_lock_release || die_json "adopted-overlay recovery lock release failed"
  printf '{"ok":true,"recovered":true}\n'
}

if [ "${VPN_UI_SOURCE_ONLY:-0}" = 1 ]; then
  return 0 2>/dev/null || exit 0
fi

trap 'overlay_process_cleanup' EXIT
trap 'overlay_process_cleanup; exit 130' INT TERM

case "${1:-status}" in
  version)
    sed -n '1p' "$VERSION_FILE" 2>/dev/null || printf 'unknown\n'
    ;;
  metadata-init)
    ensure_router_metadata || die_json "UCI metadata storage is unavailable"
    cmd_router_metadata
    ;;
  metadata|router-metadata|footer-info)
    cmd_router_metadata
    ;;
  metadata-set)
    shift
    cmd_metadata_set "$@"
    ;;
  metadata-installed)
    cmd_metadata_installed "${2:-package-first-local-ipk}"
    ;;
  metadata-sealed)
    cmd_metadata_sealed "${2:-}"
    ;;
  init)
    ensure_router_metadata || true
    require_native_ownership
    init_state
    runtime_memory_maintenance
    status_json
    ;;
  status)
    status_json
    ;;
  vpn-summary)
    vpn_summary_json
    ;;
  refresh-pings)
    cmd_refresh_pings
    ;;
  add)
    [ -n "${2:-}" ] || die_json "add requires a VLESS link"
    cmd_add "$2"
    ;;
  select)
    [ -n "${2:-}" ] || die_json "select requires a profile id"
    cmd_select "$2"
    ;;
  delete)
    [ -n "${2:-}" ] || die_json "delete requires a profile id"
    cmd_delete "$2"
    ;;
  adoption-preview)
    [ "$#" -eq 1 ] || die_json "adoption-preview takes no arguments"
    cmd_adoption_preview
    ;;
  adoption-confirm)
    [ "$#" -eq 5 ] || die_json "adoption-confirm requires path, hash, domain selector, and IP selector"
    cmd_adoption_confirm "$2" "$3" "$4" "$5"
    ;;
  overlay-recover)
    [ "$#" -eq 1 ] || die_json "overlay-recover takes no arguments"
    cmd_overlay_recover
    ;;
  apply-rules)
    cmd_apply_rules "${2:-}" "${3:-}"
    ;;
  check)
    cmd_check
    ;;
  device)
    [ -n "${2:-}" ] || die_json "device requires enable or disable"
    [ -n "${3:-}" ] || die_json "device requires a MAC address"
    cmd_device "$2" "$3" "${4:-}"
    ;;
  xray)
    [ -n "${2:-}" ] || die_json "xray requires on or off"
    cmd_xray "$2"
    ;;
  subscription-add)
    [ -n "${2:-}" ] || die_json "subscription-add requires an HTTPS URL"
    cmd_subscription_add "$2"
    ;;
  subscription-sync)
    [ -n "${2:-}" ] || die_json "subscription-sync requires an id"
    cmd_subscription_sync "$2"
    ;;
  subscription-delete)
    [ -n "${2:-}" ] || die_json "subscription-delete requires an id"
    cmd_subscription_delete "$2"
    ;;
  validate-vless)
    [ -n "${2:-}" ] || die_json "validate-vless requires a VLESS link"
    cmd_validate_vless "$2"
    ;;
  subscription-preview)
    [ -n "${2:-}" ] || die_json "subscription-preview requires an HTTPS URL"
    cmd_subscription_preview "$2"
    ;;
  auto-config)
    cmd_auto_config "${2:-0}" "${3:-0}" "${4:-12}" "${5:-}"
    ;;
  auto-tick)
    cmd_auto_tick
    ;;
  tailscale-up)
    cmd_tailscale_up "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-0}"
    ;;
  tailscale-status)
    tailscale_status_json
    ;;
  tailscale-ping)
    [ -n "${2:-}" ] || die_json "tailscale-ping requires a peer IPv4 address"
    cmd_tailscale_ping "$2"
    ;;
  tailscale-logout)
    cmd_tailscale_logout
    ;;
  tailscale-restart)
    cmd_tailscale_restart
    ;;
  tailscale-stop)
    cmd_tailscale_stop
    ;;
  update-status)
    cmd_update status
    ;;
  update-job-status)
    [ -n "${2:-}" ] || die_json "update-job-status requires an operation ID"
    [ -n "${3:-}" ] || die_json "update-job-status requires an operation kind"
    cmd_update job-status "$2" "$3"
    ;;
  update-check-start)
    cmd_update check-start
    ;;
  update-apply-start)
    cmd_update apply-start
    ;;
  update-auto)
    cmd_update set-auto "${2:-}"
    ;;
  test-domain)
    [ -n "${2:-}" ] || die_json "test-domain requires a domain"
    cmd_test_domain "$2"
    ;;
  *)
    die_json "unknown command: ${1:-}"
    ;;
esac
