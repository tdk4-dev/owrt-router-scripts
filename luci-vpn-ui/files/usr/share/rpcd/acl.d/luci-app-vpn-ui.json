{
	"luci-app-vpn-ui": {
		"description": "Grant access to VPN connectivity controls",
		"read": {
			"file": {
				"/usr/sbin/vpn-ui-readonly": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			}
		},
		"write": {
			"file": {
				"/usr/sbin/vpn-ui": [ "exec" ],
				"/usr/sbin/vpn-ui-readonly": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			}
		}
	}
}
