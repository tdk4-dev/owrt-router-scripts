# Copy to rd23.env, edit values, then run:
#   set -a
#   source ./rd23.env
#   set +a
#   ./setup-rd23-vpn-ap.sh

# OpenWrt SSH target before the script readdresses LAN.
ROUTER_HOST=192.168.1.1
ROUTER_USER=root
SSH_KEY="$HOME/.ssh/id_ed25519_openwrt"

# Router identity.
HOSTNAME=openwrt-rd23
TAILSCALE_HOSTNAME=openwrt-rd23

# Production LAN.
LAN_IP=10.77.0.1
LAN_NETMASK=255.255.255.0
LAN_CIDR=10.77.0.0/24

# Wi-Fi AP.
WIFI_COUNTRY=RU
WIFI_2G_SSID=OpenWrt-2G
WIFI_5G_SSID=OpenWrt-5G
WIFI_PASSWORD=

# Xray VLESS Reality endpoint. Must include flow=xtls-rprx-vision.
VLESS_URL=

# Headscale/Tailscale.
HEADSCALE_URL=https://headscale.example.com
# Optional for first-time login. If omitted, Tailscale must already be logged in
# or you must log in manually.
TAILSCALE_AUTHKEY=

# Optional package install. Keep 0 when the image already contains xray/tailscale.
INSTALL_PACKAGES=0
