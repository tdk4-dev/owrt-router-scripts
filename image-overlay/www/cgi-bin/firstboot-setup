#!/bin/ash
set -u

LAN_IP="${LAN_IP:-10.77.0.1}"
LAN_CIDR="${LAN_CIDR:-10.77.0.0/24}"
HOSTNAME="${HOSTNAME:-openwrt-fin0}"
STATE_DIR="${STATE_DIR:-/etc/firstboot-wizard}"
COMPLETE_FILE="$STATE_DIR/complete"
IN_PROGRESS_FILE="$STATE_DIR/in-progress"
PHASE_DIR="$STATE_DIR/phases"
PAYLOAD="/tmp/firstboot-setup.$$.json"
FILTERS_FILE="/tmp/firstboot-adguard-filters.$$"
VPN_UI_BIN="${VPN_UI_BIN:-/usr/sbin/vpn-ui}"
JSONFILTER_BIN="${JSONFILTER_BIN:-jsonfilter}"
UBUS_BIN="${UBUS_BIN:-ubus}"
VPN_PROFILE_ID=""

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' | tr '\n' ' '
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}

header_json() {
  printf 'Status: %s\r\n' "$1"
  printf 'Content-Type: application/json\r\n'
  printf 'Cache-Control: no-store\r\n'
  printf '\r\n'
}

fail() {
  header_json "200 OK"
  printf '{"ok":false,"errors":['
  json_string "$1"
  printf ']}\n'
  exit 0
}

ok_status() {
  local first phase
  header_json "200 OK"
  if [ -f "$COMPLETE_FILE" ]; then
    printf '{"ok":true,"complete":true,"inProgress":false,"completedPhases":'
  else
    printf '{"ok":true,"complete":false,"inProgress":'
    [ -f "$IN_PROGRESS_FILE" ] && printf true || printf false
    printf ',"completedPhases":'
  fi
  printf '['
  first=1
  for phase in account network wifi adguard vpn tailscale; do
    [ -f "$PHASE_DIR/$phase" ] || continue
    [ "$first" = "1" ] || printf ','
    first=0
    json_string "$phase"
  done
  printf ']}\n'
}

read_body() {
  local len="${CONTENT_LENGTH:-0}"
  [ "$len" -gt 0 ] 2>/dev/null || return 0
  dd bs=1 count="$len" 2>/dev/null
}

json_get() {
  "$JSONFILTER_BIN" -i "$PAYLOAD" -e "$1" 2>/dev/null | sed -n '1p'
}

json_list() {
  "$JSONFILTER_BIN" -i "$PAYLOAD" -e "$1" 2>/dev/null
}

bool_true() {
  case "$1" in
    true|1|yes|on) return 0 ;;
  esac
  return 1
}

phase_done() {
  [ -f "$PHASE_DIR/$1" ]
}

mark_phase_done() {
  mkdir -p "$PHASE_DIR"
  : > "$PHASE_DIR/$1"
  sync
}

wifi_radios_json() {
  local first device band label hwmode
  if [ -f /etc/router-prep/placeholder-wifi ]; then
    printf '%s' '[{"device":"placeholder2g","band":"2g","label":"2.4 GHz preview"},{"device":"placeholder5g","band":"5g","label":"5 GHz preview"}]'
    return 0
  fi
  first=1
  printf '['
  for device in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
    band="$(uci -q get "wireless.$device.band" || true)"
    hwmode="$(uci -q get "wireless.$device.hwmode" || true)"
    case "$band" in
      2g) label="2.4 GHz" ;;
      5g) label="5 GHz" ;;
      *)
        case "$hwmode" in
          *a*) band="5g"; label="5 GHz" ;;
          *) band="2g"; label="2.4 GHz" ;;
        esac
        ;;
    esac
    [ "$first" = "1" ] || printf ','
    first=0
    printf '{"device":'
    json_string "$device"
    printf ',"band":'
    json_string "$band"
    printf ',"label":'
    json_string "$label"
    printf '}'
  done
  printf ']'
}

