write_selected_filters_yaml() {
  local selected="$1"
  local id filter_id url name
  : > "$FILTERS_FILE"
  for id in $selected; do
    filter_meta "$id" >> "$FILTERS_FILE" || true
  done
  [ -s "$FILTERS_FILE" ] || return 1
  while IFS='	' read -r filter_id url name; do
    printf '  - enabled: true\n'
    printf '    url: %s\n' "$url"
    printf '    name: %s\n' "$name"
    printf '    id: %s\n' "$filter_id"
  done < "$FILTERS_FILE"
}

configure_network() {
  uci set system.@system[0].hostname="$HOSTNAME" 2>/dev/null || true
  uci commit system 2>/dev/null || true
  hostname "$HOSTNAME" 2>/dev/null || true

  uci set network.lan.ipaddr="$LAN_IP"
  uci set network.lan.netmask="255.255.255.0"
  uci set network.lan.proto="static"
  uci commit network

  uci set dhcp.lan.start="100"
  uci set dhcp.lan.limit="150"
  uci set dhcp.lan.leasetime="12h"
  uci commit dhcp

  uci -q delete firewall.lan_wan_forward
  uci set firewall.lan_wan_forward="forwarding"
  uci set firewall.lan_wan_forward.src="lan"
  uci set firewall.lan_wan_forward.dest="wan"
  uci commit firewall
}

wifi_device_for_band() {
  local wanted="$1"
  local device band hwmode
  for device in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
    band="$(uci -q get "wireless.$device.band" || true)"
    hwmode="$(uci -q get "wireless.$device.hwmode" || true)"
    if [ -z "$band" ]; then
      case "$hwmode" in
        *a*) band="5g" ;;
        *) band="2g" ;;
      esac
    fi
    [ "$band" = "$wanted" ] && {
      printf '%s\n' "$device"
      return 0
    }
  done
  return 1
}

configure_wifi_band() {
  local band="$1"
  local device="$2"
  local ssid="$3"
  local security="$4"
  local password="$5"
  local country="$6"
  local channel="$7"
  local hidden="$8"
  local isolate="$9"
  local section="firstboot_${band}"

  uci set "wireless.$device.disabled=0"
  uci set "wireless.$device.country=$country"
  uci set "wireless.$device.channel=$channel"
  uci -q delete "wireless.$section"
  uci set "wireless.$section=wifi-iface"
  uci set "wireless.$section.device=$device"
  uci set "wireless.$section.mode=ap"
  uci set "wireless.$section.network=lan"
  uci set "wireless.$section.ssid=$ssid"
  uci set "wireless.$section.encryption=$security"
  uci set "wireless.$section.hidden=$hidden"
  uci set "wireless.$section.isolate=$isolate"
  if [ "$security" = "none" ]; then
    uci -q delete "wireless.$section.key"
  else
    uci set "wireless.$section.key=$password"
  fi
}

configure_wifi() {
  local enabled="$1"
  local enable_2g="$2"
  local enable_5g="$3"
  local ssid="$4"
  local security="$5"
  local password="$6"
  local country="$7"
  local channel_2g="$8"
  local channel_5g="$9"
  local hidden="${10}"
  local isolate="${11}"
  local device_2g="" device_5g="" device

  if ! bool_true "$enabled"; then
    uci -q delete wireless.firstboot_2g
    uci -q delete wireless.firstboot_5g
    for device in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
      uci set "wireless.$device.disabled=1"
    done
    uci commit wireless 2>/dev/null || true
    wifi reload >/dev/null 2>&1 || true
    return 0
  fi

  [ -n "$ssid" ] && [ "${#ssid}" -le 32 ] || fail "Wi-Fi network name must be 1 to 32 characters."
  case "$security" in
    sae-mixed|psk2|sae|none) ;;
    *) fail "Unsupported Wi-Fi security mode." ;;
  esac
  if [ "$security" != "none" ]; then
    [ "${#password}" -ge 8 ] && [ "${#password}" -le 63 ] ||
      fail "Wi-Fi password must be 8 to 63 characters."
  fi
  printf '%s' "$country" | grep -Eq '^[A-Za-z]{2}$' || fail "Wi-Fi country code must contain two letters."
  country="$(printf '%s' "$country" | tr 'a-z' 'A-Z')"
  case "$channel_2g" in auto|[1-9]|1[0-3]) ;; *) fail "Invalid 2.4 GHz channel." ;; esac
  case "$channel_5g" in auto|[0-9][0-9]|1[0-9][0-9]) ;; *) fail "Invalid 5 GHz channel." ;; esac

  bool_true "$enable_2g" && device_2g="$(wifi_device_for_band 2g || true)"
  bool_true "$enable_5g" && device_5g="$(wifi_device_for_band 5g || true)"
  if bool_true "$enable_2g" && [ -z "$device_2g" ]; then
    fail "2.4 GHz Wi-Fi was requested but no matching radio was detected."
  fi
  if bool_true "$enable_5g" && [ -z "$device_5g" ]; then
    fail "5 GHz Wi-Fi was requested but no matching radio was detected."
  fi
  [ -n "$device_2g" ] || [ -n "$device_5g" ] || fail "Enable at least one detected Wi-Fi band."

  uci -q delete wireless.firstboot_2g
  uci -q delete wireless.firstboot_5g
  [ -z "$device_2g" ] || configure_wifi_band 2g "$device_2g" "$ssid" "$security" "$password" "$country" "$channel_2g" "$hidden" "$isolate"
  [ -z "$device_5g" ] || configure_wifi_band 5g "$device_5g" "$ssid" "$security" "$password" "$country" "$channel_5g" "$hidden" "$isolate"
  uci commit wireless
  wifi reload >/dev/null 2>&1 || fail "Wi-Fi configuration was saved but the radios did not reload."
}

configure_account() {
  local login="$1"
  local password="$2"
  local confirm="$3"
  local keys="$4"

  [ "$login" = "root" ] || fail "This image supports root SSH login only."
  [ "${#password}" -ge 8 ] || fail "SSH password must be at least 8 characters."
  [ "$password" = "$confirm" ] || fail "Password confirmation does not match."
  printf '%s\n%s\n' "$password" "$password" | passwd root >/tmp/firstboot-passwd.log 2>&1 ||
    fail "Could not set root password."

  mkdir -p /etc/dropbear
  printf '%s\n' "$keys" | awk 'NF { print }' > /etc/dropbear/authorized_keys
  chmod 600 /etc/dropbear/authorized_keys
  /etc/init.d/dropbear enable >/dev/null 2>&1 || true
  /etc/init.d/dropbear restart >/dev/null 2>&1 || true
  verify_root_login "$password" ||
    fail "Root password was written, but OpenWrt could not authenticate it."
}

verify_root_login() {
  local password="$1"
  local password_json payload response session

  password_json="$(json_escape "$password")"
  payload="{\"username\":\"root\",\"password\":\"$password_json\",\"timeout\":2}"
  response="$("$UBUS_BIN" call session login "$payload" 2>/dev/null)" || return 1
  session="$(printf '%s' "$response" |
    "$JSONFILTER_BIN" -e '@.ubus_rpc_session' 2>/dev/null | sed -n '1p')"
  [ -n "$session" ]
}

wait_http() {
  local url="$1"
  local i
  for i in $(seq 1 30); do
    curl -fsS --connect-timeout 2 --max-time 4 "$url" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

rewrite_adguard_filters() {
  local selected="$1"
  local yaml="/tmp/firstboot-adguard-yaml.$$"
  local out="/tmp/firstboot-adguard-config.$$"

  write_selected_filters_yaml "$selected" > "$yaml" || {
    rm -f "$yaml" "$FILTERS_FILE"
    fail "Select at least one AdGuard blocklist."
  }
  awk -v filters="$yaml" '
    /^querylog:/ {
      in_querylog = 1
      print
      next
    }
    in_querylog && /^[^[:space:]][^:]*:/ {
      in_querylog = 0
    }
    in_querylog && /^[[:space:]]*interval:/ {
      print "  interval: 24h"
      next
    }
    in_querylog && /^[[:space:]]*file_enabled:/ {
      print "  file_enabled: false"
      next
    }
    /^filters:/ {
      print "filters:"
      while ((getline line < filters) > 0) print line
      skip = 1
      next
    }
    /^whitelist_filters:/ { skip = 0 }
    !skip { print }
  ' /etc/adguardhome.yaml > "$out" || fail "Could not rewrite AdGuard filters."
  mv "$out" /etc/adguardhome.yaml
  rm -f "$yaml" "$FILTERS_FILE"
}

configure_adguard() {
  local user="$1"
  local password="$2"
  local selected="$3"
  local user_json password_json payload

  /etc/init.d/adguardhome stop >/dev/null 2>&1 || true
  [ -f /etc/adguardhome.yaml ] && cp /etc/adguardhome.yaml "/etc/adguardhome.yaml.bak.firstboot.$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
  rm -f /etc/adguardhome.yaml

  /etc/init.d/adguardhome enable >/dev/null 2>&1 || true
  /etc/init.d/adguardhome start >/dev/null 2>&1 || true
  wait_http "http://127.0.0.1:3000/" || fail "AdGuardHome setup UI did not start."

  user_json="$(json_escape "$user")"
  password_json="$(json_escape "$password")"
  payload="{\"web\":{\"ip\":\"0.0.0.0\",\"port\":3000},\"dns\":{\"ip\":\"0.0.0.0\",\"port\":5353},\"username\":\"$user_json\",\"password\":\"$password_json\"}"
  curl -fsS -X POST -H 'Content-Type: application/json' --data "$payload" \
    http://127.0.0.1:3000/control/install/configure >/tmp/firstboot-adguard-install.log 2>&1 ||
    fail "AdGuardHome install API failed."

  sleep 2
  /etc/init.d/adguardhome stop >/dev/null 2>&1 || true
  [ -f /etc/adguardhome.yaml ] || fail "AdGuardHome did not write a config."
  rewrite_adguard_filters "$selected"
  chmod 600 /etc/adguardhome.yaml
  AdGuardHome --check-config -c /etc/adguardhome.yaml -w /var/lib/adguardhome >/tmp/firstboot-adguard-check.log 2>&1 ||
    fail "AdGuardHome config validation failed."

  uci set dhcp.@dnsmasq[0].noresolv="1"
  uci -q delete dhcp.@dnsmasq[0].server
  uci add_list dhcp.@dnsmasq[0].server="127.0.0.1#5353"
  uci commit dhcp
  /etc/init.d/adguardhome restart >/dev/null 2>&1 || true
  /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
}

