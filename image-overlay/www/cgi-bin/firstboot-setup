#!/bin/ash
set -u

LAN_IP="10.77.0.1"
LAN_CIDR="10.77.0.0/24"
HOSTNAME="openwrt-fin0"
STATE_DIR="/etc/firstboot-wizard"
COMPLETE_FILE="$STATE_DIR/complete"
PAYLOAD="/tmp/firstboot-setup.$$.json"
FILTERS_FILE="/tmp/firstboot-adguard-filters.$$"

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' | tr '\n' ' '
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}

header_json() {
  printf 'Status: %s\r\n' "$1"
  printf 'Content-Type: application/json\r\n'
  printf 'Cache-Control: no-store\r\n'
  printf '\r\n'
}

fail() {
  header_json "200 OK"
  printf '{"ok":false,"errors":['
  json_string "$1"
  printf ']}\n'
  exit 0
}

ok_status() {
  header_json "200 OK"
  if [ -f "$COMPLETE_FILE" ]; then
    printf '{"ok":true,"complete":true}\n'
  else
    printf '{"ok":true,"complete":false}\n'
  fi
}

read_body() {
  local len="${CONTENT_LENGTH:-0}"
  [ "$len" -gt 0 ] 2>/dev/null || return 0
  dd bs=1 count="$len" 2>/dev/null
}

json_get() {
  jsonfilter -i "$PAYLOAD" -e "$1" 2>/dev/null | sed -n '1p'
}

json_list() {
  jsonfilter -i "$PAYLOAD" -e "$1" 2>/dev/null
}

bool_true() {
  case "$1" in
    true|1|yes|on) return 0 ;;
  esac
  return 1
}

