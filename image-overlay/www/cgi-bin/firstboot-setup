configure_xray_service() {
  write_xray_routes
  write_xray_transparent_init
  uci set xray.enabled="xray"
  uci set xray.enabled.enabled="1"
  uci set xray.config="xray"
  uci set xray.config.conffiles="/etc/xray/exit-st-cf.json"
  uci set xray.config.datadir="/usr/share/xray"
  uci set xray.config.format="json"
  uci -q delete xray.config.confdir
  uci commit xray
}

import_vless_profile() {
  local vless="$1"
  local id validate_result add_result

  validate_result="/tmp/firstboot-vpn-validate.$$.json"
  add_result="/tmp/firstboot-vpn-add.$$.json"
  rm -f "$validate_result" "$add_result"

  "$VPN_UI_BIN" validate-vless "$vless" >"$validate_result" 2>&1
  grep -q '"ok":true' "$validate_result" ||
    fail "Could not validate VLESS profile: $("$JSONFILTER_BIN" -i "$validate_result" -e '@.error' 2>/dev/null)"

  id="$("$JSONFILTER_BIN" -i "$validate_result" -e '@.profile.id' 2>/dev/null)"
  [ -n "$id" ] || fail "VLESS validation did not return a profile ID."

  "$VPN_UI_BIN" add "$vless" >"$add_result" 2>&1
  grep -q '"ok":true' "$add_result" ||
    fail "Could not add VLESS profile: $("$JSONFILTER_BIN" -i "$add_result" -e '@.error' 2>/dev/null)"

  rm -f "$validate_result" "$add_result"
  VPN_PROFILE_ID="$id"
}

import_subscription_profile() {
  local url="$1"
  local id add_result

  add_result="/tmp/firstboot-vpn-subscription.$$.json"
  rm -f "$add_result"

  "$VPN_UI_BIN" subscription-add "$url" >"$add_result" 2>&1
  grep -q '"ok":true' "$add_result" ||
    fail "Could not import subscription: $("$JSONFILTER_BIN" -i "$add_result" -e '@.error' 2>/dev/null)"

  id="$("$JSONFILTER_BIN" -i "$add_result" -e '@.selected' 2>/dev/null)"
  [ -n "$id" ] || fail "Subscription import did not return a selected profile ID."

  rm -f "$add_result"
  VPN_PROFILE_ID="$id"
}

configure_vpn() {
  local enabled="$1"
  local vpn_url="$2"
  local id select_result

  configure_xray_service
  "$VPN_UI_BIN" init >/tmp/firstboot-vpn-init.log 2>&1 || true

  if bool_true "$enabled"; then
    case "$vpn_url" in
      vless://*) import_vless_profile "$vpn_url" ;;
      https://*) import_subscription_profile "$vpn_url" ;;
      *) fail "A VLESS link or HTTPS subscription link is required when VPN is enabled." ;;
    esac
    id="$VPN_PROFILE_ID"
    /etc/init.d/xray enable >/dev/null 2>&1 || true
    /etc/init.d/xray-transparent enable >/dev/null 2>&1 || true
    select_result="/tmp/firstboot-vpn-select.$$.json"
    "$VPN_UI_BIN" select "$id" >"$select_result" 2>&1
    grep -q '"ok":true' "$select_result" ||
      fail "Could not enable the selected VLESS profile: $("$JSONFILTER_BIN" -i "$select_result" -e '@.error' 2>/dev/null)"
    rm -f "$select_result"
  else
    /etc/init.d/xray disable >/dev/null 2>&1 || true
    /etc/init.d/xray-transparent disable >/dev/null 2>&1 || true
    /etc/init.d/xray stop >/dev/null 2>&1 || true
    /etc/init.d/xray-transparent stop >/dev/null 2>&1 || true
  fi
}

configure_tailscale() {
  local enabled="$1"
  local login_server="$2"
  local auth_key="$3"

  if ! bool_true "$enabled"; then
    /etc/init.d/tailscale stop >/dev/null 2>&1 || true
    /etc/init.d/tailscale disable >/dev/null 2>&1 || true
    return 0
  fi

  case "$login_server" in https://*) ;; *) fail "Tailscale or Headscale URL must use HTTPS." ;; esac
  [ -n "$auth_key" ] || fail "Tailscale preauth key is required."

  uci set tailscale.settings="settings"
  uci set tailscale.settings.log_stderr="1"
  uci set tailscale.settings.log_stdout="1"
  uci set tailscale.settings.port="41641"
  uci set tailscale.settings.state_file="/etc/tailscale/tailscaled.state"
  uci set tailscale.settings.fw_mode="nftables"
  uci commit tailscale
  /etc/init.d/tailscale enable >/dev/null 2>&1 || true
  /etc/init.d/tailscale restart >/dev/null 2>&1 || /etc/init.d/tailscale start >/dev/null 2>&1 || true

  set -- \
    "--login-server=$login_server" \
    "--auth-key=$auth_key" \
    "--hostname=$HOSTNAME" \
    "--advertise-exit-node" \
    "--advertise-routes=$LAN_CIDR" \
    "--accept-dns=false" \
    "--netfilter-mode=off"
  tailscale up "$@" >/tmp/firstboot-tailscale.log 2>&1 ||
    tailscale up --reset "$@" >/tmp/firstboot-tailscale.log 2>&1 ||
    fail "tailscale up failed."
}

apply_setup() {
  local login password confirm keys
  local wifi_enabled wifi_2g wifi_5g wifi_ssid wifi_security wifi_password wifi_country
  local wifi_channel_2g wifi_channel_5g wifi_hidden wifi_isolate
  local vpn_enabled vless selected tailscale_enabled tailscale_url tailscale_key now

  [ ! -f "$COMPLETE_FILE" ] || fail "Initial setup is already complete."
  read_body > "$PAYLOAD"
  login="$(json_get '@.account.login')"
  password="$(json_get '@.account.password')"
  confirm="$(json_get '@.account.passwordConfirm')"
  keys="$(json_get '@.account.authorizedKeys')"
  wifi_enabled="$(json_get '@.wifi.enabled')"
  wifi_2g="$(json_get '@.wifi.enable2g')"
  wifi_5g="$(json_get '@.wifi.enable5g')"
  wifi_ssid="$(json_get '@.wifi.ssid')"
  wifi_security="$(json_get '@.wifi.security')"
  wifi_password="$(json_get '@.wifi.password')"
  wifi_country="$(json_get '@.wifi.country')"
  wifi_channel_2g="$(json_get '@.wifi.channel2g')"
  wifi_channel_5g="$(json_get '@.wifi.channel5g')"
  wifi_hidden="$(json_get '@.wifi.hidden')"
  wifi_isolate="$(json_get '@.wifi.isolate')"
  vpn_enabled="$(json_get '@.vpn.enabled')"
  vless="$(json_get '@.vpn.vlessUrl')"
  selected="$(json_list '@.adguard.selectedFilterIds[*]' | tr '\n' ' ')"
  tailscale_enabled="$(json_get '@.tailscale.enabled')"
  tailscale_url="$(json_get '@.tailscale.loginServer')"
  tailscale_key="$(json_get '@.tailscale.authKey')"

  mkdir -p "$STATE_DIR" "$PHASE_DIR"
  : > "$IN_PROGRESS_FILE"
  sync

  # Credentials are intentionally reapplied on every resumed submission.
  # A phase marker must never cause a newly entered password to be skipped.
  configure_account "$login" "$password" "$confirm" "$keys"
  mark_phase_done account
  if ! phase_done network; then
    configure_network
    mark_phase_done network
  fi
  if ! phase_done wifi; then
    configure_wifi "$wifi_enabled" "$wifi_2g" "$wifi_5g" "$wifi_ssid" "$wifi_security" \
      "$wifi_password" "$wifi_country" "$wifi_channel_2g" "$wifi_channel_5g" "$wifi_hidden" "$wifi_isolate"
    mark_phase_done wifi
  fi
  if ! phase_done adguard; then
    configure_adguard "$login" "$password" "$selected"
    mark_phase_done adguard
  fi
  if ! phase_done vpn; then
    configure_vpn "$vpn_enabled" "$vless"
    mark_phase_done vpn
  fi
  if ! phase_done tailscale; then
    configure_tailscale "$tailscale_enabled" "$tailscale_url" "$tailscale_key"
    mark_phase_done tailscale
  fi

  touch "$COMPLETE_FILE"
  rm -f "$IN_PROGRESS_FILE"
  sync
  /etc/init.d/firewall restart >/dev/null 2>&1 || true

  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  header_json "200 OK"
  cat <<EOF
{"ok":true,"data":{"id":"firstboot-$now","appliedAt":"$now","preview":{"router":{"lanIp":"$LAN_IP"},"wifi":{"enabled":$(bool_true "$wifi_enabled" && printf true || printf false)},"vpn":{"enabled":$(bool_true "$vpn_enabled" && printf true || printf false)},"tailscale":{"enabled":$(bool_true "$tailscale_enabled" && printf true || printf false)}},"phases":["Set root account and SSH keys","Configure LAN on $LAN_IP","Configure Wi-Fi if requested","Write AdGuardHome filters","Configure VPN panel and Xray","Configure Tailscale if requested","Mark first-boot setup complete"]}}
EOF
}

finish_redirect() {
  local target="$1"
  local host="${HTTP_HOST:-$LAN_IP}"
  host="${host%%:*}"

  [ -f "$COMPLETE_FILE" ] || {
    printf 'Status: 302 Found\r\nLocation: /setup/\r\nCache-Control: no-store\r\n\r\n'
    exit 0
  }

  case "$target" in
    luci) location="/cgi-bin/luci/" ;;
    vpn) location="/cgi-bin/luci/admin/network/vpn" ;;
    adguard) location="${REQUEST_SCHEME:-http}://$host:3000/" ;;
    *) location="/cgi-bin/luci/" ;;
  esac
  printf 'Status: 302 Found\r\nLocation: %s\r\nCache-Control: no-store\r\n\r\n' "$location"
}

if [ "${FIRSTBOOT_SETUP_LIB_ONLY:-0}" != "1" ]; then
  action="$(printf '%s' "${QUERY_STRING:-}" | sed -n 's/.*action=\([^&]*\).*/\1/p')"
  case "${action:-status}" in
    status) ok_status ;;
    bootstrap) bootstrap ;;
    apply) apply_setup ;;
    finish)
      target="$(printf '%s' "${QUERY_STRING:-}" | sed -n 's/.*target=\([^&]*\).*/\1/p')"
      finish_redirect "${target:-luci}"
      ;;
    *) fail "Unknown setup action." ;;
  esac
fi
