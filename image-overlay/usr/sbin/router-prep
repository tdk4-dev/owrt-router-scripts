#!/bin/ash
set -eu

STATE_DIR="${ROUTER_PREP_STATE_DIR:-/etc/router-prep}"
TOKEN_FILE="$STATE_DIR/token"
POLICY_FILE="$STATE_DIR/customer-policy.conf"
SEALED_FILE="$STATE_DIR/sealed"
PLACEHOLDER_WIFI_FILE="$STATE_DIR/placeholder-wifi"
VPN_UI_BIN="${ROUTER_PREP_VPN_UI_BIN:-/usr/sbin/vpn-ui}"
ROUTER_PREP_HARDWARE_PROFILE="${ROUTER_PREP_HARDWARE_PROFILE:-}"

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' | tr '\n' ' '
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}

ensure_state() {
  local default_adguard=1
  [ "$(hardware_profile)" = "xiaomi-ax3000t-rd23" ] && default_adguard=0
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  if [ ! -f "$POLICY_FILE" ]; then
    cat > "$POLICY_FILE" <<EOF
INSTALL_MODE='owner-prepared-standard'
CUSTOMER_VPN='1'
CUSTOMER_TAILSCALE='0'
CUSTOMER_UPDATES='1'
CUSTOMER_PACKAGES='0'
CUSTOMER_ADGUARD='$default_adguard'
SUPPORT_ACCESS='0'
SUPPORT_LEVEL='standard'
REGISTRATION_STATE='support-disabled'
EOF
    chmod 600 "$POLICY_FILE"
  fi
  migrate_policy_metadata_fields
}

hardware_profile() {
  local board="${ROUTER_PREP_HARDWARE_PROFILE:-}"
  [ -n "$board" ] || board="$(sed -n '1p' /tmp/sysinfo/board_name 2>/dev/null || true)"
  if [ -z "$board" ] && command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
    board="$(ubus call system board 2>/dev/null | jsonfilter -e '@.board_name' 2>/dev/null || true)"
  fi
  case "$board" in
    xiaomi-ax3000t-rd23|*xiaomi*ax3000t*|*mi-router-ax3000t*|*rd23*) printf '%s' xiaomi-ax3000t-rd23 ;;
    *) printf '%s' generic ;;
  esac
}

policy_value() {
  sed -n "s/^$1='\([^']*\)'/\1/p" "$POLICY_FILE" | sed -n '1p'
}

default_support_level() {
  case "$1" in
    owner-prepared-standard) printf standard ;;
    owner-prepared-managed) printf managed ;;
    self-managed-image|manual-ipk-install|legacy-migrated) printf self-managed ;;
    dev-vm) printf developer ;;
    *) printf none ;;
  esac
}

default_registration_state() {
  case "$1" in
    owner-prepared-standard|owner-prepared-managed)
      [ "$2" = "1" ] && printf support-enabled || printf support-disabled
      ;;
    *) printf local-only ;;
  esac
}

migrate_policy_metadata_fields() {
  local mode support_access support_level registration
  mode="$(policy_value INSTALL_MODE)"
  support_access="$(policy_value SUPPORT_ACCESS)"
  [ -n "$mode" ] || mode="owner-prepared-standard"
  [ "$support_access" = "1" ] || support_access=0
  support_level="$(policy_value SUPPORT_LEVEL)"
  registration="$(policy_value REGISTRATION_STATE)"
  if [ -z "$support_level" ]; then
    printf "SUPPORT_LEVEL='%s'\n" "$(default_support_level "$mode")" >> "$POLICY_FILE"
  fi
  if [ -z "$registration" ]; then
    printf "REGISTRATION_STATE='%s'\n" "$(default_registration_state "$mode" "$support_access")" >> "$POLICY_FILE"
  fi
  chmod 600 "$POLICY_FILE"
}

valid_support_level() {
  case "$1" in none|self-managed|standard|managed|priority|developer) return 0 ;; esac
  return 1
}

valid_registration_state() {
  case "$1" in unregistered|local-only|support-registered|support-enabled|support-disabled|unknown) return 0 ;; esac
  return 1
}

sync_router_metadata() {
  local mode="$1" support_level="$2" registration="$3" support_access="${4:-0}"
  [ -x "$VPN_UI_BIN" ] || return 0
  "$VPN_UI_BIN" metadata-set "$mode" "$support_level" "$registration" 1 "$support_access" >/dev/null
}

new_token() {
  local token
  token="$(dd if=/dev/urandom bs=24 count=1 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null || true)"
  if [ -z "$token" ]; then
    token="$(printf '%s:%s' "$(date +%s)" "$$" | sha256sum | awk '{ print $1 }')"
  fi
  printf '%s\n' "$token" > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  printf '%s\n' "$token"
}

current_token() {
  ensure_state
  if [ -f "$SEALED_FILE" ]; then
    printf 'router preparation is sealed; run router-prep unseal first\n' >&2
    exit 1
  fi
  if [ -s "$TOKEN_FILE" ]; then
    sed -n '1p' "$TOKEN_FILE"
  else
    new_token
  fi
}

authorize() {
  local candidate="${1:-}" current
  ensure_state
  [ -f "$SEALED_FILE" ] && return 1
  [ -n "$candidate" ] || return 1
  [ -s "$TOKEN_FILE" ] || return 1
  current="$(sed -n '1p' "$TOKEN_FILE")"
  [ "$candidate" = "$current" ]
}

status_json() {
  ensure_state
  printf '{"ok":true,"sealed":'
  [ -f "$SEALED_FILE" ] && printf true || printf false
  printf ',"placeholderWifi":'
  [ -f "$PLACEHOLDER_WIFI_FILE" ] && printf true || printf false
  printf ',"policy":{'
  printf '"installMode":'
  json_string "$(policy_value INSTALL_MODE)"
  printf ',"supportLevel":'
  json_string "$(policy_value SUPPORT_LEVEL)"
  printf ',"registrationState":'
  json_string "$(policy_value REGISTRATION_STATE)"
  printf ',"customerVpn":'
  grep -q "^CUSTOMER_VPN='1'" "$POLICY_FILE" && printf true || printf false
  printf ',"customerTailscale":'
  grep -q "^CUSTOMER_TAILSCALE='1'" "$POLICY_FILE" && printf true || printf false
  printf ',"customerUpdates":'
  grep -q "^CUSTOMER_UPDATES='1'" "$POLICY_FILE" && printf true || printf false
  printf ',"customerPackages":'
  grep -q "^CUSTOMER_PACKAGES='1'" "$POLICY_FILE" && printf true || printf false
  printf ',"customerAdguard":'
  grep -q "^CUSTOMER_ADGUARD='1'" "$POLICY_FILE" && printf true || printf false
  printf ',"supportAccess":'
  grep -q "^SUPPORT_ACCESS='1'" "$POLICY_FILE" && printf true || printf false
  printf '}}\n'
}

write_policy() {
  local mode="${1:-owner-prepared-standard}" vpn="${2:-1}" tailscale="${3:-0}" updates="${4:-1}" packages="${5:-0}" adguard="${6:-1}" support="${7:-0}"
  local support_level="${8:-}" registration="${9:-}"
  ensure_state
  case "$mode" in
    owner-prepared-managed|owner-prepared-standard|self-managed-image|manual-ipk-install|legacy-migrated|dev-vm|unknown) ;;
    *) printf 'invalid install mode: %s\n' "$mode" >&2; exit 1 ;;
  esac
  [ -n "$support_level" ] || support_level="$(default_support_level "$mode")"
  [ -n "$registration" ] || registration="$(default_registration_state "$mode" "$support")"
  valid_support_level "$support_level" || {
    printf 'invalid support level: %s\n' "$support_level" >&2
    exit 1
  }
  valid_registration_state "$registration" || {
    printf 'invalid registration state: %s\n' "$registration" >&2
    exit 1
  }
  if [ "$adguard" = "1" ] && [ "$(hardware_profile)" = "xiaomi-ax3000t-rd23" ]; then
    printf 'AdGuardHome is deferred for Xiaomi AX3000T/RD23 and cannot be enabled in customer policy.\n' >&2
    exit 1
  fi
  cat > "$POLICY_FILE" <<EOF
INSTALL_MODE='$mode'
CUSTOMER_VPN='$vpn'
CUSTOMER_TAILSCALE='$tailscale'
CUSTOMER_UPDATES='$updates'
CUSTOMER_PACKAGES='$packages'
CUSTOMER_ADGUARD='$adguard'
SUPPORT_ACCESS='$support'
SUPPORT_LEVEL='$support_level'
REGISTRATION_STATE='$registration'
EOF
  chmod 600 "$POLICY_FILE"
  sync_router_metadata "$mode" "$support_level" "$registration" "$support"
}

apply_policy() {
  ensure_state
  # Current v0.8 policy enforcement is intentionally conservative. The policy
  # file is consumed by installer/menu validation and by later UI gating.
  chmod 600 "$POLICY_FILE"
}

seal() {
  ensure_state
  rm -f "$TOKEN_FILE" "$PLACEHOLDER_WIFI_FILE"
  : > "$SEALED_FILE"
  chmod 600 "$SEALED_FILE"
  [ ! -x "$VPN_UI_BIN" ] || "$VPN_UI_BIN" metadata-sealed 1 >/dev/null
}

unseal() {
  ensure_state
  rm -f "$SEALED_FILE"
  new_token >/dev/null
  [ ! -x "$VPN_UI_BIN" ] || "$VPN_UI_BIN" metadata-sealed 0 >/dev/null
}

case "${1:-status}" in
  token)
    current_token
    ;;
  new-token)
    ensure_state
    [ -f "$SEALED_FILE" ] && {
      printf 'router preparation is sealed; run router-prep unseal first\n' >&2
      exit 1
    }
    new_token
    ;;
  authorize)
    authorize "${2:-}"
    ;;
  status)
    status_json
    ;;
  policy)
    shift
    write_policy "$@"
    ;;
  apply-policy)
    apply_policy
    ;;
  placeholder-wifi)
    ensure_state
    case "${2:-on}" in
      on|1|true) : > "$PLACEHOLDER_WIFI_FILE"; chmod 600 "$PLACEHOLDER_WIFI_FILE" ;;
      off|0|false) rm -f "$PLACEHOLDER_WIFI_FILE" ;;
      *) printf 'usage: router-prep placeholder-wifi on|off\n' >&2; exit 1 ;;
    esac
    ;;
  seal)
    seal
    ;;
  unseal)
    unseal
    ;;
  *)
    cat >&2 <<'EOF'
usage: router-prep token|new-token|authorize TOKEN|status|policy MODE VPN TAILSCALE UPDATES PACKAGES ADGUARD SUPPORT [SUPPORT_LEVEL] [REGISTRATION_STATE]|apply-policy|placeholder-wifi on|off|seal|unseal
EOF
    exit 1
    ;;
esac
